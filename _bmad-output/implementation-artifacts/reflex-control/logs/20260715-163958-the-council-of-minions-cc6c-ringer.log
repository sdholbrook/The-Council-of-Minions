ck-thread-version:conversation-001-v2\",\n          \"com_content_hash\": \"sha256:2cd2a580e654c773a5a202ba768346831258194c7084099bcd87dcf39352d419\",\n          \"com_attachment_refs\": \"mock/manual attachment metadata only, not tenant verified\",\n          \"com_permission_snapshot\": \"mock/manual evidence, not tenant verified\",\n          \"com_sensitivity_label\": \"unknown\",\n          \"com_retention_or_hold_flags\": \"unknown\",\n          \"com_extraction_status\": \"new\",\n          \"com_source_to_work_item_rationale\": \"Superseding mock capture of the drifted Outlook thread. The record stays hash-only with no authorized body content, so extraction review starts fresh on this record once live Outlook reads are approved; the prior record's rationale is referenced, not restated.\",\n          \"com_data_boundary_policy\": \"hash_only\"\n        }\n      }\n    ],\n    \"receipts\": [\n      {\n        \"com_receipt_id\": \"CR-LOCAL-DRIFT-001\",\n        \"com_verb\": \"source_drifted\",\n        \"com_actor_type\": \"system\",\n        \"com_actor_id\": \"local-bmad-validator\",\n        \"com_authority_basis\": \"local non-tenant Story 1.5 contract validation\",\n        \"com_occurred_at\": \"2026-07-13T15:45:00-04:00\",\n        \"com_idempotency_key\": \"drift:CSR-MANUAL-MEETING-001:manual-note-version:2026-07-13:v2\",\n        \"com_before_state\": \"CSR-MANUAL-MEETING-001 captured 2026-07-13T09:05:00-04:00 with no com_source_version_ref recorded and no drift observed\",\n        \"com_after_state\": \"drift evidence recorded for CSR-MANUAL-MEETING-001: com_source_version_ref manual-note-version:2026-07-13:v2 pending receipt-gated apply in Epic 2\",\n        \"com_evidence_refs\": \"driftEvents[CSR-MANUAL-MEETING-001]; summary:manual-meeting-note-001-v2; sha256:781510e2c041c4e320e8aefa0f6ccb3620aa97616098d5592715405f105539d0\",\n        \"com_decision_rationale\": \"The meeting note drifted after capture (the checklist deadline moved from Friday to Wednesday), so a drift receipt is appended instead of rewriting the prior capture or its extraction rationale.\",\n        \"com_confidence\": 0.9,\n        \"com_result\": \"accepted\",\n        \"com_policy_flags\": \"local_contract_evidence_only; no_tenant_write; no_outbound_action\",\n        \"com_append_only_locked\": true\n      },\n      {\n        \"com_receipt_id\": \"CR-LOCAL-SUPERSEDE-001\",\n        \"com_verb\": \"source_drifted\",\n        \"com_actor_type\": \"system\",\n        \"com_actor_id\": \"local-bmad-validator\",\n        \"com_authority_basis\": \"local non-tenant Story 1.5 contract validation\",\n        \"com_occurred_at\": \"2026-07-13T16:15:00-04:00\",\n        \"com_idempotency_key\": \"supersede:CSR-OUTLOOK-THREAD-MOCK-001:CSR-OUTLOOK-THREAD-MOCK-002\",\n        \"com_before_state\": \"held\",\n        \"com_after_state\": \"superseded\",\n        \"com_evidence_refs\": \"supersessions[CSR-OUTLOOK-THREAD-MOCK-001]; CSR-OUTLOOK-THREAD-MOCK-002; mock-thread-version:conversation-001-v2\",\n        \"com_decision_rationale\": \"A newer mock thread snapshot supersedes the held hash-only record via CSR-OUTLOOK-THREAD-MOCK-002; the prior record and the rationale it produced stay unchanged, and the superseded status move stays receipt-gated to Epic 2.\",\n        \"com_confidence\": 0.85,\n        \"com_result\": \"accepted\",\n        \"com_policy_flags\": \"local_contract_evidence_only; no_tenant_write; no_outbound_action\",\n        \"com_append_only_locked\": true\n      }\n    ],\n    \"receiptSourceLinks\": [\n      {\n        \"com_name\": \"CR-LOCAL-DRIFT-001 drift evidence - CSR-MANUAL-MEETING-001\",\n        \"com_receipt\": \"CR-LOCAL-DRIFT-001\",\n        \"com_source_record\": \"CSR-MANUAL-MEETING-001\",\n        \"com_evidence_role\": \"drift_evidence\"\n      },\n      {\n        \"com_name\": \"CR-LOCAL-SUPERSEDE-001 drift evidence - CSR-OUTLOOK-THREAD-MOCK-001\",\n        \"com_receipt\": \"CR-LOCAL-SUPERSEDE-001\",\n        \"com_source_record\": \"CSR-OUTLOOK-THREAD-MOCK-001\",\n        \"com_evidence_role\": \"drift_evidence\"\n      },\n      {\n        \"com_name\": \"CR-LOCAL-SUPERSEDE-001 drift evidence - CSR-OUTLOOK-THREAD-MOCK-002\",\n        \"com_receipt\": \"CR-LOCAL-SUPERSEDE-001\",\n        \"com_source_record\": \"CSR-OUTLOOK-THREAD-MOCK-002\",\n        \"com_evidence_role\": \"drift_evidence\"\n      }\n    ],\n    \"workItemsFlaggedForReview\": [\n      {\n        \"workItem\": \"CWI-LOCAL-MEETING-ACTION-001\",\n        \"flaggedBy\": \"CR-LOCAL-DRIFT-001\",\n        \"reason\": \"The drifted meeting note moves the tenant readiness checklist deadline from Friday to Wednesday, so the extraction rationale and urgency behind this proposed meeting action no longer match the observed source version and need human review.\",\n        \"flagMechanism\": \"Local review-needed flag recorded in this slice; intended to surface as the Council Queue drift indicator once that review surface lands (no app curation changes in this slice). Any com_state_group move (for example proposed to in_review) requires a new Receipt and stays deferred to Epic 2 Story 2.3.\",\n        \"stateGroupChangedInThisSlice\": false\n      }\n    ],\n    \"workItemsUnaffected\": [\n      {\n        \"workItem\": \"CWI-LOCAL-DECISION-002\",\n        \"note\": \"The observed drift touches only commitment (1)'s checklist deadline; commitment (2)'s deferral decision is unchanged in the newer note version, so this Work Item is explicitly not flagged for review.\"\n      },\n      {\n        \"workItem\": \"CWI-LOCAL-RISK-001\",\n        \"note\": \"The observed drift touches only commitment (1)'s checklist deadline; commitment (3)'s publisher prefix risk is unchanged in the newer note version, so this Work Item is explicitly not flagged for review.\"\n      }\n    ],\n    \"sourceUpdatesDeferred\": [\n      {\n        \"sourceRecord\": \"CSR-MANUAL-MEETING-001\",\n        \"deferredUpdate\": \"Applying the observed drift evidence (com_source_version_ref manual-note-version:2026-07-13:v2, com_content_hash, com_observed_modified_at) to the live record is a receipt-backed mutation gated to Epic 2 Story 2.3; no live tenant write was performed in this slice.\"\n      },\n      {\n        \"sourceRecord\": \"CSR-OUTLOOK-THREAD-MOCK-001\",\n        \"deferredUpdate\": \"com_extraction_status may become superseded only through a receipt-backed mutation once Epic 2 Story 2.3 receipt semantics exist; the prior record and the rationale it produced stay unchanged and no live tenant write was performed in this slice.\"\n      }\n    ],\n    \"workItemStateChangesDeferred\": [\n      {\n        \"workItem\": \"CWI-LOCAL-MEETING-ACTION-001\",\n        \"deferredUpdate\": \"Any com_state_group move driven by this drift (for example proposed to in_review) requires a new receipt-backed mutation gated to Epic 2 Story 2.3; this slice records the review flag only and performs no state change.\"\n      }\n    ]\n  },\n  \"acceptanceMapping\": [\n    {\n      \"acceptanceCriterion\": 1,\n      \"localEvidence\": [\n        \"driftRun.driftEvents for CSR-MANUAL-MEETING-001 with new com_source_version_ref, com_content_hash, and com_observed_modified_at later than capture, plus a prior-evidence block stating no prior version ref was recorded\",\n        \"driftRun.receipts CR-LOCAL-DRIFT-001 (verb source_drifted) bound to the drifted source by a drift_evidence receiptSourceLinks entry\",\n        \"driftRun.supersessions embeds CSR-OUTLOOK-THREAD-MOCK-002 superseding CSR-OUTLOOK-THREAD-MOCK-001 via com_parent_ref with receipt CR-LOCAL-SUPERSEDE-001 (before held, after superseded)\",\n        \"guards.priorRationaleAndReceiptsUnchanged=true; the superseded extraction status appears only inside sourceUpdatesDeferred and no 1.1-1.4 artifact is modified\"\n      ],\n      \"tenantEvidenceRequired\": \"Live drift detection plus applying com_source_version_ref or the superseded extraction status to tenant records are receipt-gated to Epic 2 Story 2.3 and remain VERIFY IN TENANT; this slice is local contract evidence only.\"\n    },\n    {\n      \"acceptanceCriterion\": 2,\n      \"localEvidence\": [\n        \"driftRun.workItemsFlaggedForReview names only CWI-LOCAL-MEETING-ACTION-001 with a drift-specific reason and flag mechanism\",\n        \"driftRun.workItemsUnaffected explicitly clears CWI-LOCAL-DECISION-002 and CWI-LOCAL-RISK-001, the other two Story 1.4 items from the drifted source\",\n        \"stateGroupChangedInThisSlice=false and workItemStateChangesDeferred require a new Receipt for any resulting state change\",\n        \"guards.noWorkItemStateChangeInThisSlice=true\"\n      ],\n      \"tenantEvidenceRequired\": \"Surfacing the review flag in the live Council Queue and any receipt-backed com_state_group change remain gated to Epic 2 Story 2.3; no tenant Work Item was modified for this slice.\"\n    }\n  ]\n}","lineStart":1,"lineEnd":200,"totalLines":200,"truncated":false}},"title":"_bmad-output/implementation-artifacts/source-drift-supersession-slice.json","time":{"start":1784297567254,"end":1784297567292}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Let me start by reading the key files to understand the patterns I need to follow.","format":"unknown","index":0}]}},"id":"prt_f706c3031001dYsahHWPcqBXVM","sessionID":"ses_08f93ebf9ffelfzoCNiy0olR2A","messageID":"msg_f706c1626001fzHvrZdtWJOeiL"}}
