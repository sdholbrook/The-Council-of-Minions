rom\",\n        \"projectionDate\": \"2026-07-13T16:05:00+00:00\",\n        \"canonicalSource\": \"council-semantic-contract\"\n      },\n      {\n        \"projectionId\": \"PROJ-LOCAL-SCP-006\",\n        \"canonicalTermId\": \"type:meeting_action\",\n        \"canonicalVocabulary\": \"com_workitemtype\",\n        \"canonicalValue\": \"meeting_action\",\n        \"targetPlane\": \"dataverse-semantic-model\",\n        \"projectedRepresentation\": \"Dataverse choice value meeting_action on com_workitemtype; semantic model glossary entry Meeting Action\",\n        \"projectionDate\": \"2026-07-13T16:00:00+00:00\",\n        \"canonicalSource\": \"council-semantic-contract\"\n      }\n    ],\n    \"driftDetection\": {\n      \"detectionId\": \"PROJ-DRIFT-LOCAL-SCP-001\",\n      \"projectedTermProjectionId\": \"PROJ-LOCAL-SCP-005\",\n      \"canonicalTermId\": \"edge:proposed_from\",\n      \"canonicalVocabulary\": \"com_graphedgetype\",\n      \"canonicalValue\": \"proposed_from\",\n      \"targetPlane\": \"fabric-iq-ontology\",\n      \"canonicalProjectedRepresentation\": \"Fabric IQ relationship type proposed_from (Work Item → Source Record); ontology edge label Proposed From\",\n      \"observedPlaneRepresentation\": \"Fabric IQ relationship type proposedFromSource (inferred alias processes Work Item to Source); ontology edge label Sourced Proposal — platform-inferred rename NOT approved in the Council Semantic Contract\",\n      \"detectionRationale\": \"Fabric IQ ontology surface shows a renamed edge label for the same binding that Council projects as proposed_from. The plane is not authoritative; this slice records the drift detection and flags reconciliation back to the Council Semantic Contract. The plane representation is never edited in place; a reconciliation Work Item / contract update path is the only allowed remediation and stays receipt-gated.\",\n      \"reconciliationAction\": \"flag_for_reconciliation_never_edit_in_place\",\n      \"detectedAt\": \"202