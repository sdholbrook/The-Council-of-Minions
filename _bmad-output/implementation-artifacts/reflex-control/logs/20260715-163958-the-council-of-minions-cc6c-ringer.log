naleTexts = @()\n441:   if ($null -ne $priorRecord -and (Test-HasNonEmptyField -Record $priorRecord -Field \"com_source_to_work_item_rationale\")) {\n442:     $driftPriorRationaleTexts += [string]$priorRecord.com_source_to_work_item_rationale\n443:   }\n444:   foreach ($outcome in @($story14ZeroItemOutcomes | Where-Object { $_.sourceRecord -eq $driftSourceId })) {\n445:     if (Test-HasNonEmptyField -Record $outcome -Field \"extraction_rationale\") {\n446:       $driftPriorRationaleTexts += [string]$outcome.extraction_rationale\n447:     }\n448:   }\n449:   foreach ($item in @($knownWorkItems | Where-Object { $_.com_primary_source_record -eq $driftSourceId })) {\n450:     foreach ($rationaleField in @(\"extraction_rationale\", \"com_rationale\")) {\n451:       if (Test-HasNonEmptyField -Record $item -Field $rationaleField) {\n452:         $driftPriorRationaleTexts += [string]$item.$rationaleField\n453:       }\n454:     }\n455:   }\n456:   foreach ($priorRationale in $driftPriorRationaleTexts) {\n457:     Test-PriorRationaleRestated -Issues $issues -RawSliceText $rawSliceText -PriorRationale $priorRationale -Subject $subject\n458:   }\n459: \n460:   $observed = $driftEvent.observedEvidence\n461:   if ($null -eq $observed) {\n462:     Add-Issue $issues \"$subject must carry an observedEvidence block.\"\n463:     continue\n464:   }\n465:   Test-NoPriorMutationFields -Issues $issues -Record $observed -Subject \"$subject observedEvidence\"\n466: \n467:   # priorEvidence is audited whenever it is present, regardless of whether the prior slice records a version ref.\n468:   $prior = $driftEvent.priorEvidence\n469:   if ($null -ne $prior) {\n470:     Test-NoPriorMutationFields -Issues $issues -Record $prior -Subject \"$subject priorEvidence\"\n471:     if ((Test-HasNonEmptyField -Record $prior -Field \"com_captured_at\") -and $null -ne $priorRecord -and (Test-HasNonEmptyField -Record $priorRecord -Field \"com_captured_at\")) {\n472:       $echoedCapturedAt = Get-Comparable