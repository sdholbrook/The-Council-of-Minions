averseRowsNotUsedAsCouncilIdentity\": true,\n    \"receiptsAreLocalContractEvidenceOnly\": true,\n    \"receiptsAreAppendOnlyCorrectionsAreNewReceipts\": true,\n    \"authorityExpansionRequiresExplicitApprovalReceipt\": true,\n    \"activationStrictlyFollowsApprovalReceipt\": true,\n    \"denialConstrainsSkillToBeforeAuthority\": true,\n    \"denialRationaleRemainsVisibleForFutureReview\": true,\n    \"noWorkItemStateChangeInThisSlice\": true\n  },\n  \"authoritySetVocabulary\": {\n    \"basis\": \"Manifest com_councilskill has no explicit authority-set column: com_authority_class is a single choice (manual_only/ask_before_use/approved_automatic) and com_allowed_context/com_required_inputs are free multiline text. This slice models an authority set as a Story 5.2 local extension comprising authorityClass, dataScopes, tools, and externalActions, projecting onto com_authority_class plus com_allowed_context. Authority-set members are reproducible local-contract identifiers (for example dataverse.com_councilworkitem.read, email.send), not tenant enum values; adopting them as tenant-wide choice values is a deferred, receipt-gated decision for Epic 2. This is a documented local extension, NOT a claim that the meaning graph owns skill workflow state; guards.meaningGraphDoesNotOwnWorkflowState and guards.noWorkItemStateChangeInThisSlice remain true.\",\n    \"expansionTriggersApproval\": [\n      \"add_data_scope\",\n      \"add_tool_use\",\n      \"add_external_action\",\n      \"broaden_authority_class\"\n    ],\n    \"nonExpandingChanges\": [\n      \"clarify_trigger\",\n      \"fix_proof_owed_text\",\n      \"narrow_authority_class\"\n    ]\n  },\n  \"failureCodeVocabulary\": {\n    \"basis\": \"Manifest com_councilreceipt.com_failure_code is a free-text column with no enumerated choice set, so this slice declares a Story 5.2 local extension naming the denial code used here together with its kind, retry allowance, and human-review semantics. Codes are reproducible local-contract identifiers, not tenant enums; adopting them as tenant-wide choice values is a deferred, receipt-gated decision for Epic 2.\",\n    \"codes\": [\n      {\n        \"code\": \"skill_authority_expansion_denied\",\n        \"kind\": \"policy_denial\",\n        \"retryAllowed\": false,\n        \"humanReviewRequired\": true,\n        \"definition\": \"A proposed Skill authority expansion that adds data access, tool use, external action, or a broader authority class was denied because it failed the human-approval or scope-breadth gate (FR25/FR13). The skill remains inactive or constrained to its before authority set; the denial is non-retryable without a policy change or a re-scoped proposal, and the rationale stays visible for future review.\"\n      }\n    ]\n  },\n  \"expansionRun\": {\n    \"runId\": \"SKILL-LOCAL-2026-07-14-001\",\n    \"actorType\": \"human\",\n    \"actorId\": \"Doug\",\n    \"authorityBasis\": \"local non-tenant Story 5.2 contract validation; skill authority expansion is receipt-gated and any live write stays deferred to Epic 2\",\n    \"semanticContractVersion\": \"2026-07-07\",\n    \"inputSlicesFrom\": [\n      \"manual-source-record-slice.json\",\n      \"outlook-source-reference-slice.json\"\n    ],\n    \"decisionPolicy\": {\n      \"authorityExpansionRequiresExplicitHumanApprovalReceipt\": true,\n      \"activationStrictlyFollowsAnApprovalReceiptNotAFlag\": true,\n      \"denialConstrainsTheSkillToItsBeforeAuthoritySet\": true,\n      \"denialRationaleRemainsVisibleForFutureReview\": true,\n      \"beforeAndAfterAuthoritySetsDifferExactlyByTheDeclaredDelta\": true,\n      \"liveSkillMutationReceiptGatedToEpic2\": true,\n      \"receiptsAreAppendOnlyCorrectionsAreNewReceipts\": true\n    },\n    \"skills\": [\n      {\n        \"evidenceStatus\": \"mock_manual_not_tenant_verified\",\n        \"skillRecord\": {\n          \"com_name\": \"Daily meeting digest skill (proposed, candidate)\",\n          \"com_council_skill_id\": \"CSK-LOCAL-MEETING-DIGEST-001\",\n          \"com_trigger\": \"Each weekday morning, summarize the prior day's Council meeting-action notes into a digest for the weekly brief.\",\n          \"com_allowed_context\": \"Project: Council of Minions MVP; scope: meeting-action Work Items captured from the prior day.\",\n          \"com_required_inputs\": \"Prior-day meeting-action Work Items and their linked Source Records.\",\n          \"com_authority_class\": \"manual_only\",\n          \"com_approval_requirements\": \"Requires human (Doug) approval before activation because the install adds Dataverse read access and the email.send tool plus an external action (FR25/FR13).\",\n          \"com_proof_owed\": \"Each digest cites the Work Items and Source Records it summarized; no external send occurs without a prior approval receipt.\",\n          \"com_update_policy\": \"Any authority expansion (added data scope, tool, external action, or broadened authority class) requires a NEW approval receipt; corrections are new receipts, never edits.\",\n          \"com_status\": \"candidate\"\n        },\n        \"expansionKind\": \"installation\",\n        \"sourceRecord\": \"CSR-MANUAL-MEETING-001\",\n        \"proposedExpansion\": {\n          \"beforeAuthoritySet\": {\n            \"authorityClass\": \"manual_only\",\n            \"dataScopes\": [],\n            \"tools\": [],\n            \"externalActions\": []\n          },\n          \"proposedAfterAuthoritySet\": {\n            \"authorityClass\": \"ask_before_use\",\n            \"dataScopes\": [\n              \"outlook.calendar.read\",\n              \"dataverse.com_councilworkitem.read\"\n            ],\n            \"tools\": [\n              \"email.send\"\n            ],\n            \"externalActions\": [\n              \"send_email_on_behalf\"\n            ]\n          },\n          \"declaredDelta\": {\n            \"authorityClassChangedFrom\": \"manual_only\",\n            \"authorityClassChangedTo\": \"ask_before_use\",\n            \"addedDataScopes\": [\n              \"outlook.calendar.read\",\n              \"dataverse.com_councilworkitem.read\"\n            ],\n            \"addedTools\": [\n              \"email.send\"\n            ],\n            \"addedExternalActions\": [\n              \"send_email_on_behalf\"\n            ]\n          },\n          \"approvalRequiredReason\": \"FR25: the install adds data access (outlook.calendar.read, dataverse.com_councilworkitem.read) and tool use (email.send) plus an external action (send_email_on_behalf), so activation requires human approval before the skill may run with this authority (FR13).\"\n        },\n        \"decision\": \"approved\",\n        \"decisionReceipt\": \"CR-LOCAL-SKILL-APPROVE-001\",\n        \"activation\": {\n          \"activatedSkill\": \"CSK-LOCAL-MEETING-DIGEST-001\",\n          \"gateReceipt\": \"CR-LOCAL-SKILL-APPROVE-001\",\n          \"effectiveAt\": \"2026-07-14T10:30:00-04:00\",\n          \"activatedAuthoritySet\": {\n            \"authorityClass\": \"ask_before_use\",\n            \"dataScopes\": [\n              \"outlook.calendar.read\",\n              \"dataverse.com_councilworkitem.read\"\n            ],\n            \"tools\": [\n              \"email.send\"\n            ],\n            \"externalActions\": [\n              \"send_email_on_behalf\"\n            ]\n          },\n          \"activationNote\": \"Activation is gated to approval receipt CR-LOCAL-SKILL-APPROVE-001; the live skill row mutation (com_status candidate->active, com_authority_class manual_only->ask_before_use, applying the granted dataScopes/tools/externalActions) is a receipt-backed deferred update to Epic 2. No live tenant write was performed in this slice.\"\n        }\n      },\n      {\n        \"evidenceStatus\": \"mock_manual_not_tenant_verified\",\n        \"skillRecord\": {\n          \"com_name\": \"Completed decision Fabric publisher skill (proposed, candidate, denied)\",\n          \"com_council_skill_id\": \"CSK-LOCAL-FABRIC-PUBLISHER-001\",\n          \"com_trigger\": \"When a decision Work Item is completed, publish its summary to a Fabric lakehouse and trigger a Fabric dataflow.\",\n          \"com_allowed_context\": \"Project: Council of Minions MVP; scope: completed decision Work Items.\",\n          \"com_required_inputs\": \"Completed decision Work Items and their linked Source Records.\",\n          \"com_authority_class\": \"manual_only\",\n          \"com_approval_requirements\": \"Requires human (Doug) approval before activation because the install adds a Dataverse write scope and two Fabric external actions and seeks approved_automatic authority (FR25/FR13).\",\n          \"com_proof_owed\": \"Each publish cites the completed decision and the Fabric target; no write occurs without a prior approval receipt.\",\n          \"com_update_policy\": \"Any authority expansion requires a NEW approval receipt; corrections are new receipts, never edits.\",\n          \"com_status\": \"candidate\"\n        },\n        \"expansionKind\": \"installation\",\n        \"sourceRecord\": \"CSR-OUTLOOK-MESSAGE-MOCK-001\",\n        \"proposedExpansion\": {\n          \"beforeAuthoritySet\": {\n            \"authorityClass\": \"manual_only\",\n            \"dataScopes\": [],\n            \"tools\": [],\n            \"externalActions\": []\n          },\n          \"proposedAfterAuthoritySet\": {\n            \"authorityClass\": \"approved_automatic\",\n            \"dataScopes\": [\n              \"dataverse.com_councilworkitem.read\",\n              \"dataverse.com_councilworkitem.write\"\n            ],\n            \"tools\": [],\n            \"externalActions\": [\n              \"fabric.publish\",\n              \"fabric.dataflow.write\"\n            ]\n          },\n          \"declaredDelta\": {\n            \"authorityClassChangedFrom\": \"manual_only\",\n            \"authorityClassChangedTo\": \"approved_automatic\",\n            \"addedDataScopes\": [\n              \"dataverse.com_councilworkitem.read\",\n              \"dataverse.com_councilworkitem.write\"\n            ],\n            \"addedTools\": [],\n            \"addedExternalActions\": [\n              \"fabric.publish\",\n              \"fabric.dataflow.write\"\n            ]\n          },\n          \"approvalRequiredReason\": \"FR25: the install adds a data write scope (dataverse.com_councilworkitem.write) and external actions (fabric.publish, fabric.dataflow.write) and seeks approved_automatic authority, so activation requires human approval before the skill may run with this authority (FR13).\"\n        },\n        \"decision\": \"denied\",\n        \"decisionReceipt\": \"CR-LOCAL-SKILL-DENY-001\",\n        \"denial\": {\n          \"deniedSkill\": \"CSK-LOCAL-FABRIC-PUBLISHER-001\",\n          \"denialRationale\": \"Doug denied the expansion because it combines a Dataverse write scope, two Fabric external actions, and an approved_automatic authority class for a brand-new skill with no prior use history: that bypasses the human-approval gate for tenant-affecting writes and external actions (FR13). The skill remains inactive (candidate, manual_only, empty authority) and the denial rationale stays visible on the record for a re-scoped proposal.\",\n          \"effectiveAuthoritySet\": {\n            \"authorityClass\": \"manual_only\",\n            \"dataScopes\": [],\n            \"tools\": [],\n            \"externalActions\": []\n          },\n          \"denialReceipt\": \"CR-LOCAL-SKILL-DENY-001\",\n          \"policyFlagsTraced\": [\n            \"authority_expansion_requires_human_approval\",\n            \"write_scope_not_auto_approved\",\n            \"external_action_requires_human_approval\",\n            \"approved_automatic_not_granted_without_prior_use_history\"\n          ],\n          \"evidenceRefsTraced\": [\n            \"CSR-OUTLOOK-MESSAGE-MOCK-001\",\n            \"CSK-LOCAL-FABRIC-PUBLISHER-001\"\n          ]\n        }\n      }\n    ],\n    \"receipts\": [\n      {\n        \"com_receipt_id\": \"CR-LOCAL-SKILL-APPROVE-001\",\n        \"com_work_item\": null,\n        \"com_verb\": \"approved\",\n        \"com_actor_type\": \"human\",\n        \"com_actor_id\": \"Doug\",\n        \"com_authority_basis\": \"local non-tenant Story 5.2 contract validation; skill authority expansion approval is receipt-gated and any live activation write stays deferred to Epic 2\",\n        \"com_occurred_at\": \"2026-07-14T10:15:00-04:00\",\n        \"com_idempotency_key\": \"skill:approve:CSK-LOCAL-MEETING-DIGEST-001:2026-07-14T10:15\",\n        \"com_before_state\": \"candidate; manual_only; dataScopes=[]; tools=[]; externalActions=[]\",\n        \"com_after_state\": \"active; ask_before_use; dataScopes=[outlook.calendar.read, dataverse.com_councilworkitem.read]; tools=[email.send]; externalActions=[send_email_on_behalf]\",\n        \"com_evidence_refs\": \"CSK-LOCAL-MEETING-DIGEST-001; CSR-MANUAL-MEETING-001\",\n        \"com_decision_rationale\": \"Doug approved installing CSK-LOCAL-MEETING-DIGEST-001 with read-only Outlook/Dataverse access and an email.send tool because the daily meeting digest need was observed in CSR-MANUAL-MEETING-001 and the expansion is bounded to ask_before_use (not approved_automatic), so each run still asks before acting. No live tenant write was performed; activation is a receipt-gated deferred update.\",\n        \"com_confidence\": 0.85,\n        \"com_result\": \"accepted\",\n        \"com_failure_code\": null,\n        \"com_policy_flags\": \"local_contract_evidence_only; no_tenant_write; no_outbound_action; human_approval_required; authority_expansion_approved\",\n        \"com_append_only_locked\": true,\n        \"beforeAuthoritySet\": {\n          \"authorityClass\": \"manual_only\",\n          \"dataScopes\": [],\n          \"tools\": [],\n          \"externalActions\": []\n        },\n        \"afterAuthoritySet\": {\n          \"authorityClass\": \"ask_before_use\",\n          \"dataScopes\": [\n            \"outlook.calendar.read\",\n            \"dataverse.com_councilworkitem.read\"\n          ],\n          \"tools\": [\n            \"email.send\"\n          ],\n          \"externalActions\": [\n            \"send_email_on_behalf\"\n          ]\n        }\n      },\n      {\n        \"com_receipt_id\": \"CR-LOCAL-SKILL-DENY-001\",\n        \"com_work_item\": null,\n        \"com_verb\": \"policy_denied\",\n        \"com_actor_type\": \"human\",\n        \"com_actor_id\": \"Doug\",\n        \"com_authority_basis\": \"local non-tenant Story 5.2 contract validation; skill authority expansion denial is receipt-gated and the skill stays constrained to its before authority set\",\n        \"com_occurred_at\": \"2026-07-14T11:00:00-04:00\",\n        \"com_idempotency_key\": \"skill:deny:CSK-LOCAL-FABRIC-PUBLISHER-001:2026-07-14T11:00\",\n        \"com_before_state\": \"candidate; manual_only; dataScopes=[]; tools=[]; externalActions=[]\",\n        \"com_after_state\": \"candidate; manual_only; dataScopes=[]; tools=[]; externalActions=[] (expansion denied; skill constrained to before authority)\",\n        \"com_evidence_refs\": \"CSK-LOCAL-FABRIC-PUBLISHER-001; CSR-OUTLOOK-MESSAGE-MOCK-001\",\n        \"com_decision_rationale\": \"Doug denied installing CSK-LOCAL-FABRIC-PUBLISHER-001 with a Dataverse write scope, two Fabric external actions, and an approved_automatic authority class because that bypasses the human-approval gate for tenant-affecting writes and external actions (FR13) and the skill has no prior use history. The skill remains candidate (inactive) at its before authority set; the denial rationale stays visible for a re-scoped proposal. No live tenant write was performed.\",\n        \"com_confidence\": 0.9,\n        \"com_result\": \"rejected\",\n        \"com_failure_code\": \"skill_authority_expansion_denied\",\n        \"com_policy_flags\": \"local_contract_evidence_only; no_tenant_write; no_outbound_action; policy_denied; authority_expansion_requires_human_approval; human_approval_required; write_scope_not_auto_approved; external_action_requires_human_approval; approved_automatic_not_granted_without_prior_use_history\",\n        \"com_append_only_locked\": true,\n        \"beforeAuthoritySet\": {\n          \"authorityClass\": \"manual_only\",\n          \"dataScopes\": [],\n          \"tools\": [],\n          \"externalActions\": []\n        },\n        \"proposedAfterAuthoritySet\": {\n          \"authorityClass\": \"approved_automatic\",\n          \"dataScopes\": [\n            \"dataverse.com_councilworkitem.read\",\n            \"dataverse.com_councilworkitem.write\"\n          ],\n          \"tools\": [],\n          \"externalActions\": [\n            \"fabric.publish\",\n            \"fabric.dataflow.write\"\n          ]\n        },\n        \"denialRationale\": \"Doug denied the expansion because it combines a Dataverse write scope, two Fabric external actions, and an approved_automatic authority class for a brand-new skill with no prior use history: that bypasses the human-approval gate for tenant-affecting writes and external actions (FR13). The skill remains inactive (candidate, manual_only, empty authority) and the denial rationale stays visible on the record for a re-scoped proposal.\"\n      }\n    ],\n    \"receiptSourceLinks\": [\n      {\n        \"com_name\": \"CR-LOCAL-SKILL-APPROVE-001 approval evidence - CSR-MANUAL-MEETING-001\",\n        \"com_receipt\": \"CR-LOCAL-SKILL-APPROVE-001\",\n        \"com_source_record\": \"CSR-MANUAL-MEETING-001\",\n        \"com_evidence_role\": \"approval\"\n      },\n      {\n        \"com_name\": \"CR-LOCAL-SKILL-DENY-001 denial evidence - CSR-OUTLOOK-MESSAGE-MOCK-001\",\n        \"com_receipt\": \"CR-LOCAL-SKILL-DENY-001\",\n        \"com_source_record\": \"CSR-OUTLOOK-MESSAGE-MOCK-001\",\n        \"com_evidence_role\": \"failure_evidence\"\n      }\n    ],\n    \"skillUpdatesDeferred\": [\n      {\n        \"skill\": \"CSK-LOCAL-MEETING-DIGEST-001\",\n        \"gateReceipt\": \"CR-LOCAL-SKILL-APPROVE-001\",\n        \"deferredUpdate\": \"Activating the live skill row (com_status candidate->active, com_authority_class manual_only->ask_before_use, applying the granted dataScopes/tools/externalActions) is a receipt-backed mutation gated to approval receipt CR-LOCAL-SKILL-APPROVE-001 and to Epic 2; no live tenant write was performed in this slice.\"\n      },\n      {\n        \"skill\": \"CSK-LOCAL-FABRIC-PUBLISHER-001\",\n        \"gateReceipt\": \"CR-LOCAL-SKILL-DENY-001\",\n        \"deferredUpdate\": \"The denied expansion is recorded for future review only; the live skill row stays candidate/manual_only with empty authority. Any re-scoped proposal requires a NEW approval receipt; no live tenant write was performed in this slice.\"\n      }\n    ]\n  },\n  \"acceptanceMapping\": [\n    {\n      \"acceptanceCriterion\": 1,\n      \"localEvidence\": [\n        \"expansionRun.skills CSK-LOCAL-MEETING-DIGEST-001 with skillRecord candidate/manual_only and proposedExpansion beforeAuthoritySet (manual_only, empty scopes) and proposedAfterAuthoritySet (ask_before_use, dataScopes outlook.calendar.read + dataverse.com_councilworkitem.read, tools email.send, externalActions send_email_on_behalf) plus declaredDelta naming exactly the added scopes/tools/actions and the authority class change\",\n        \"expansionRun.receipts CR-LOCAL-SKILL-APPROVE-001 (verb approved, actor_type human, actor_id Doug, com_authority_basis, com_decision_rationale, com_evidence_refs CSK-LOCAL-MEETING-DIGEST-001; CSR-MANUAL-MEETING-001, result accepted) carries beforeAuthoritySet and afterAuthoritySet matching the proposedExpansion before/after authority sets\",\n        \"expansionRun.skills CSK-LOCAL-MEETING-DIGEST-001 activation.gateReceipt=CR-LOCAL-SKILL-APPROVE-001 (a real slice receipt with verb approved/result accepted), activation.effectiveAt 2026-07-14T10:30:00-04:00 is on or after the approval receipt com_occurred_at 2026-07-14T10:15:00-04:00 (temporal + receipt-chain, not a self-asserted flag), and activation.activatedAuthoritySet equals proposedAfterAuthoritySet\",\n        \"guards.authorityExpansionRequiresExplicitApprovalReceipt=true and guards.activationStrictlyFollowsApprovalReceipt=true\"\n      ],\n      \"tenantEvidenceRequired\": \"Writing the live Skill row, applying the approved authority set, and recording the approval receipt to tenant Dataverse tables are receipt-gated to Epic 2; this slice is local contract evidence only.\"\n    },\n    {\n      \"acceptanceCriterion\": 2,\n      \"localEvidence\": [\n        \"expansionRun.skills CSK-LOCAL-FABRIC-PUBLISHER-001 with decision=denied, skillRecord com_status candidate (non-active) and com_authority_class manual_only, and denial.effectiveAuthoritySet equal to proposedExpansion.beforeAuthoritySet (manual_only, empty scopes) proving the skill is constrained to its before authority and not activated\",\n        \"expansionRun.receipts CR-LOCAL-SKILL-DENY-001 (verb policy_denied, result rejected, com_failure_code skill_authority_expansion_denied declared in failureCodeVocabulary, policy_flags carrying policy_denied + human_approval_required + write_scope_not_auto_approved + external_action_requires_human_approval + approved_automatic_not_granted_without_prior_use_history) and denial.denialRationale non-empty so the rationale is visible for future review\",\n        \"expansionRun.skills CSK-LOCAL-FABRIC-PUBLISHER-001 has no activation block (denied expansions do not activate) and skillUpdatesDeferred records that the live skill row stays candidate/manual_only with empty authority\",\n        \"guards.denialConstrainsSkillToBeforeAuthority=true and guards.denialRationaleRemainsVisibleForFutureReview=true\"\n      ],\n      \"tenantEvidenceRequired\": \"Surfacing the policy denial and the constrained Skill record on the live Council Queue is a receipt-backed mutation gated to Epic 2; no tenant Skill row was modified for this slice.\"\n    }\n  ]\n}","lineStart":1,"lineEnd":344,"totalLines":344,"truncated":false}},"title":"_bmad-output/implementation-artifacts/skill-authority-expansion-slice.json","time":{"start":1784297577413,"end":1784297577431}},"id":"prt_f706c59a8001mK5SYK210Afbi6","sessionID":"ses_08f93ebceffedu2bMofCsFqa23","messageID":"msg_f706c40b50015N946SyXVksdKR"}}
