{"type":"tool_use","timestamp":1784297568666,"sessionID":"ses_08f93ebc0ffe1KnUJW6Wj62UYD","part":{"type":"tool","tool":"read","callID":"call_df794dda19094df0b84f5ee3","state":{"status":"completed","input":{"filePath":"/home/doug/.ringer/work/bmad-hybrid/5-5-validate-dataverse-mvp-operational-store-readiness/_bmad-output/implementation-artifacts/dataverse-readiness-slice.json"},"output":"<path>/home/doug/.ringer/work/bmad-hybrid/5-5-validate-dataverse-mvp-operational-store-readiness/_bmad-output/implementation-artifacts/dataverse-readiness-slice.json</path>\n<type>file</type>\n<content>\n1: {\n2:   \"artifactVersion\": \"2026-07-14\",\n3:   \"storyKey\": \"5-5-validate-dataverse-mvp-operational-store-readiness\",\n4:   \"status\": \"local-contract-not-tenant-verified\",\n5:   \"purpose\": \"Prove Dataverse MVP operational store readiness locally as CONTRACT evidence only: a read-only preflight contract describing the expected `pac auth who`, `pac env who`, and environment-settings evidence shape with every tenant value marked VERIFY IN TENANT and deferred-to-tenant; a story-scoped write policy mapping which manifest tables/columns each future implementation story needs (without forcing the full target shape upfront); and rollback/audit boundary statements per planned write scope. Write scripts stay disabled (writeScriptsDisabled=true) until Doug approves Dataverse sandbox writes and publisher prefix; those approvals are present as PENDING entries and no approval receipt is fabricated. No live pac/tenant call is performed in this slice; every would-be live write appears as a deferred entry naming its receipt gate.\",\n6:   \"guards\": {\n7:     \"noTenantWrites\": true,\n8:     \"noOutboundAction\": true,\n9:     \"writeScriptsDisabled\": true,\n10:     \"preflightEvidenceDeferredToTenant\": true,\n11:     \"noApprovalReceiptFabricated\": true,\n12:     \"fullShapeNotForcedUpfront\": true,\n13:     \"schemaWritesTiedToStoryScope\": true,\n14:     \"rollbackAuditBoundaryPerPlannedWriteScope\": true,\n15:     \"receiptsAreLocalContractEvidenceOnly\": true,\n16:     \"noLivePacCallInThisSlice\": true\n17:   },\n18:   \"dataverseReadinessRun\": {\n19:     \"runId\": \"READINESS-LOCAL-2026-07-14-001\",\n20:     \"actorType\": \"system\",\n21:     \"actorId\": \"local-bmad-validator\",\n22:     \"authorityBasis\": \"local non-tenant Story 5.5 contract validation; no live pac call and no tenant write performed\",\n23:     \"semanticContractVersion\": \"2026-07-07\",\n24:     \"inputManifestRef\": \"dataverse-mvp-schema-manifest.json\",\n25:     \"inputDecisionPacketRef\": \"tenant-decision-packet.json\",\n26:     \"inputSprintStatusRef\": \"sprint-status.yaml\",\n27:     \"inputSourceRecordsFrom\": [\n28:       \"manual-source-record-slice.json\",\n29:       \"outlook-source-reference-slice.json\",\n30:       \"proposed-work-item-extraction-slice.json\",\n31:       \"zero-multi-item-extraction-slice.json\",\n32:       \"source-drift-supersession-slice.json\"\n33:     ],\n34:     \"decisionPolicy\": {\n35:       \"preflightMustProveExpectedEnvironmentAndOrganizationBeforeAnyWrite\": true,\n36:       \"writeScriptsStayDisabledUntilDougApprovesSandboxWritesAndPublisherPrefix\": true,\n37:       \"noApprovalReceiptIsFabricatedWhileApprovalsArePending\": true,\n38:       \"schemaWritesTiedToCurrentStoryNeededTablesColumnsRelationshipsViews\": true,\n39:       \"dryRunManifestMayDescribeFullTargetShapeWithoutForcingItUpfront\": true,\n40:       \"rollbackAndAuditBoundaryStatedPerPlannedWriteScope\": true,\n41:       \"liveDataverseMutationReceiptGatedToEpic2Story23\": true,\n42:       \"receiptsAreLocalContractEvidenceOnly\": true\n43:     },\n44:     \"preflightContract\": {\n45:       \"evidenceState\": \"deferred-to-tenant\",\n46:       \"verificationMarker\": \"VERIFY IN TENANT\",\n47:       \"noLivePacCallPerformed\": true,\n48:       \"expectedCommands\": [\n49:         {\n50:           \"command\": \"pac auth who\",\n51:           \"purpose\": \"Prove the authenticated user context that would issue any future write.\",\n52:           \"evidenceShape\": {\n53:             \"userContextUPN\": \"VERIFY IN TENANT\",\n54:             \"loggedInUser\": \"VERIFY IN TENANT\",\n55:             \"tenantId\": \"VERIFY IN TENANT\"\n56:           },\n57:           \"evidenceState\": \"deferred-to-tenant\",\n58:           \"deferredTo\": \"Epic 5 tenant-readiness gate; live run of `pac auth who` is receipt-gated to a Doug-approved read-only preflight\"\n59:         },\n60:         {\n61:           \"command\": \"pac env who\",\n62:           \"purpose\": \"Prove the target environment ID, environment name, organization ID, and environment URL match the committed manifest target before any write.\",\n63:           \"evidenceShape\": {\n64:             \"environmentId\": \"VERIFY IN TENANT\",\n65:             \"environmentName\": \"VERIFY IN TENANT\",\n66:             \"organizationId\": \"VERIFY IN TENANT\",\n67:             \"environmentUrl\": \"VERIFY IN TENANT\"\n68:           },\n69:           \"evidenceState\": \"deferred-to-tenant\",\n70:           \"deferredTo\": \"Epic 5 tenant-readiness gate; live `pac env who` match against dataverse-mvp-schema-manifest.json target is receipt-gated to a Doug-approved read-only preflight\"\n71:         },\n72:         {\n73:           \"command\": \"pac env list-settings\",\n74:           \"purpose\": \"Capture environment settings evidence (organization settings, admin mode, throttle status) as read-only context for the readiness decision.\",\n75:           \"evidenceShape\": {\n76:             \"organizationSettings\": \"VERIFY IN TENANT\",\n77:             \"settingsHash\": \"VERIFY IN TENANT\",\n78:             \"adminMode\": \"VERIFY IN TENANT\"\n79:           },\n80:           \"evidenceState\": \"deferred-to-tenant\",\n81:           \"deferredTo\": \"Epic 5 tenant-readiness gate; live `pac env list-settings` capture is receipt-gated to a Doug-approved read-only preflight\"\n82:         }\n83:       ],\n84:       \"matchPolicy\": \"When the live preflight runs, the `pac env who` environment ID and organization ID MUST equal dataverse-mvp-schema-manifest.json target.environmentId and target.organizationId; a mismatch blocks every write. This slice records the expected SHAPE only and defers the concrete values to the tenant; no concrete environment or organization id is recorded here.\"\n85:     },\n86:     \"pendingApprovals\": [\n87:       {\n88:         \"approvalEntryId\": \"APPR-LOCAL-DV-SANDBOX-WRITES-001\",\n89:         \"decision\": \"dataverseSandboxWrites\",\n90:         \"requiredBefore\": \"dataverse-write\",\n91:         \"state\": \"PENDING\",\n92:         \"requiredApprover\": \"Doug\",\n93:         \"question\": \"Are Dataverse sandbox writes allowed after read-only preflight proves the target environment?\",\n94:         \"allowedValues\": [\n95:           \"forbidden\",\n96:           \"allowed_after_readonly_preflight\"\n97:         ],\n98:         \"receiptGate\": \"No approval receipt (CR-LOCAL-*) is fabricated for this approval until Doug explicitly approves; dataverse-apply-mvp-schema.ps1 must stay in DRY RUN ONLY mode and writeScriptsDisabled stays true.\",\n99:         \"writeScriptsDisabledUntilApproved\": true,\n100:         \"backingReceiptId\": null\n101:       },\n102:       {\n103:         \"approvalEntryId\": \"APPR-LOCAL-PUBLISHER-PREFIX-001\",\n104:         \"decision\": \"publisherPrefix\",\n105:         \"requiredBefore\": \"solution-creation\",\n106:         \"state\": \"PENDING\",\n107:         \"requiredApprover\": \"Doug\",\n108:         \"question\": \"What Dataverse publisher prefix should confirm the placeholder prefix before any solution creation write?\",\n109:         \"allowedValues\": [\n110:           \"com\"\n111:         ],\n112:         \"receiptGate\": \"No approval receipt (CR-LOCAL-*) is fabricated for this approval until Doug confirms the publisher prefix; publisher/solution creation writes stay disabled.\",\n113:         \"writeScriptsDisabledUntilApproved\": true,\n114:         \"backingReceiptId\": null\n115:       }\n116:     ],\n117:     \"dryRunSchemaManifest\": {\n118:       \"manifestRef\": \"dataverse-mvp-schema-manifest.json\",\n119:       \"manifestVersion\": \"2026-07-08\",\n120:       \"fullShapeNotForcedUpfront\": true,\n121:       \"fullShapeDescription\": \"dataverse-mvp-schema-manifest.json describes the full MVP target shape (14 tables, 15 global choices, model-driven app, sitemap). The dry run MAY reference the full shape for planning, but no implementation story is allowed to force all tables/columns to be created before that story needs them.\",\n122:       \"storyScopedWritePolicy\": [\n123:         {\n124:           \"storyKey\": \"1-1-capture-manual-source-records\",\n125:           \"epic\": 1,\n126:           \"tables\": [\n127:             \"com_councilsourcerecord\"\n128:           ],\n129:           \"columnsByTable\": {\n130:             \"com_councilsourcerecord\": [\n131:               \"com_name\",\n132:               \"com_council_source_record_id\",\n133:               \"com_source_system\",\n134:               \"com_source_kind\",\n135:               \"com_source_object_ref\",\n136:               \"com_captured_at\",\n137:               \"com_captured_by\",\n138:               \"com_extraction_status\",\n139:               \"com_source_to_work_item_rationale\",\n140:               \"com_data_boundary_policy\"\n141:             ]\n142:           },\n143:           \"relationships\": [],\n144:           \"views\": [\n145:             \"New Source Records\"\n146:           ],\n147:           \"writeScopeNote\": \"Story 1.1 only needs the Source Record table and its capture/boundary columns; it must not force Work Item or Receipt tables to exist.\",\n148:           \"exampleExistingRows\": [\n149:             \"CSR-MANUAL-SUMMARY-001\"\n150:           ]\n151:         },\n152:         {\n153:           \"storyKey\": \"1-3-extract-proposed-work-items-from-source-records\",\n154:           \"epic\": 1,\n155:           \"tables\": [\n156:             \"com_councilworkitem\",\n157:             \"com_councilworkitemsource\",\n158:             \"com_councilreceipt\"\n159:           ],\n160:           \"columnsByTable\": {\n161:             \"com_councilworkitem\": [\n162:               \"com_title\",\n163:               \"com_council_work_item_id\",\n164:               \"com_type\",\n165:               \"com_summary\",\n166:               \"com_state_group\",\n167:               \"com_risk_class\",\n168:               \"com_primary_source_record\",\n169:               \"com_rationale\",\n170:               \"com_approval_required\",\n171:               \"com_semantic_contract_version\"\n172:             ],\n173:             \"com_councilworkitemsource\": [\n174:               \"com_name\",\n175:               \"com_work_item\",\n176:               \"com_source_record\",\n177:               \"com_source_role\"\n178:             ],\n179:             \"com_councilreceipt\": [\n180:               \"com_receipt_id\",\n181:               \"com_work_item\",\n182:               \"com_verb\",\n183:               \"com_actor_type\",\n184:               \"com_actor_id\",\n185:               \"com_authority_basis\",\n186:               \"com_occurred_at\",\n187:               \"com_idempotency_key\",\n188:               \"com_result\",\n189:               \"com_append_only_locked\"\n190:             ]\n191:           },\n192:           \"relationships\": [\n193:             \"com_councilworkitem.com_primary_source_record -> com_councilsourcerecord\",\n194:             \"com_councilworkitemsource.com_work_item -> com_councilworkitem\",\n195:             \"com_councilworkitemsource.com_source_record -> com_councilsourcerecord\"\n196:           ],\n197:           \"views\": [\n198:             \"Proposed Work Items\"\n199:           ],\n200:           \"writeScopeNote\": \"Story 1.3 needs Work Item, Work Item Source, and Receipt tables with the proposed verb only; it must not force Graph or Memory tables to exist.\",\n201:           \"exampleExistingRows\": [\n202:             \"CWI-LOCAL-DECISION-001\",\n203:             \"CR-LOCAL-APPROVAL-PROPOSED-001\"\n204:           ]\n205:         },\n206:         {\n207:           \"storyKey\": \"1-5-handle-source-drift-and-supersession\",\n208:           \"epic\": 1,\n209:           \"tables\": [\n210:             \"com_councilsourcerecord\",\n211:             \"com_councilreceipt\",\n212:             \"com_councilreceiptsource\"\n213:           ],\n214:           \"columnsByTable\": {\n215:             \"com_councilsourcerecord\": [\n216:               \"com_council_source_record_id\",\n217:               \"com_parent_ref\",\n218:               \"com_source_version_ref\",\n219:               \"com_content_hash\",\n220:               \"com_observed_modified_at\",\n221:               \"com_extraction_status\"\n222:             ],\n223:             \"com_councilreceipt\": [\n224:               \"com_receipt_id\",\n225:               \"com_verb\",\n226:               \"com_before_state\",\n227:               \"com_after_state\",\n228:               \"com_evidence_refs\",\n229:               \"com_idempotency_key\",\n230:               \"com_append_only_locked\"\n231:             ],\n232:             \"com_councilreceiptsource\": [\n233:               \"com_name\",\n234:               \"com_receipt\",\n235:               \"com_source_record\",\n236:               \"com_evidence_role\"\n237:             ]\n238:           },\n239:           \"relationships\": [\n240:             \"com_councilreceiptsource.com_receipt -> com_councilreceipt\",\n241:             \"com_councilreceiptsource.com_source_record -> com_councilsourcerecord\"\n242:           ],\n243:           \"views\": [\n244:             \"Source Records With Drift Risk\"\n245:           ],\n246:           \"writeScopeNote\": \"Story 1.5 needs the source_drifted verb on Receipt and the drift_evidence role on Receipt Source; it must not force Work Item state columns to change.\",\n247:           \"exampleExistingRows\": [\n248:             \"CSR-MANUAL-MEETING-001\",\n249:             \"CR-LOCAL-DRIFT-001\"\n250:           ]\n251:         },\n252:         {\n253:           \"storyKey\": \"2-1-maintain-the-work-item-execution-shell\",\n254:           \"epic\": 2,\n255:           \"tables\": [\n256:             \"com_councilworkitem\",\n257:             \"com_councilreceipt\"\n258:           ],\n259:           \"columnsByTable\": {\n260:             \"com_councilworkitem\": [\n261:               \"com_council_work_item_id\",\n262:               \"com_state_group\",\n263:               \"com_owner_candidate\",\n264:               \"com_approved_owner\",\n265:               \"com_urgency\",\n266:               \"com_recommended_next_action\",\n267:               \"com_created_receipt\"\n268:             ],\n269:             \"com_councilreceipt\": [\n270:               \"com_receipt_id\",\n271:               \"com_work_item\",\n272:               \"com_verb\",\n273:               \"com_occurred_at\",\n274:               \"com_idempotency_key\",\n275:               \"com_append_only_locked\"\n276:             ]\n277:           },\n278:           \"relationships\": [\n279:             \"com_councilworkitem.com_created_receipt -> com_councilreceipt\"\n280:           ],\n281:           \"views\": [\n282:             \"Needs Human Approval\"\n283:           ],\n284:           \"writeScopeNote\": \"Story 2.1 needs the Work Item execution shell columns and the proposed-verb receipt chain; it must not force approval-scope columns to mutate.\",\n285:           \"exampleExistingRows\": [\n286:             \"CWI-LOCAL-SHELL-DECISION-001\",\n287:             \"CR-LOCAL-SHELL-CREATE-001\"\n288:           ]\n289:         },\n290:         {\n291:           \"storyKey\": \"2-3-apply-receipt-backed-queue-state-changes\",\n292:           \"epic\": 2,\n293:           \"tables\": [\n294:             \"com_councilworkitem\",\n295:             \"com_councilreceipt\",\n296:             \"com_councilreceiptsource\"\n297:           ],\n298:           \"columnsByTable\": {\n299:             \"com_councilworkitem\": [\n300:               \"com_council_work_item_id\",\n301:               \"com_state_group\"\n302:             ],\n303:             \"com_councilreceipt\": [\n304:               \"com_receipt_id\",\n305:               \"com_work_item\",\n306:               \"com_verb\",\n307:               \"com_before_state\",\n308:               \"com_after_state\",\n309:               \"com_idempotency_key\",\n310:               \"com_result\",\n311:               \"com_append_only_locked\"\n312:             ],\n313:             \"com_councilreceiptsource\": [\n314:               \"com_receipt\",\n315:               \"com_source_record\",\n316:               \"com_evidence_role\"\n317:             ]\n318:           },\n319:           \"relationships\": [\n320:             \"com_councilreceipt.com_work_item -> com_councilworkitem\"\n321:           ],\n322:           \"views\": [\n323:             \"In Review\",\n324:             \"Completed Recently\",\n325:             \"Failed Needs Review\"\n326:           ],\n327:           \"writeScopeNote\": \"Story 2.3 is the canonical receipt-backed mutation story; every live Dataverse mutation from earlier slices is gated to this story. It needs only the state-change columns and the receipt verbs it exercises.\",\n328:           \"exampleExistingRows\": [\n329:             \"CWI-LOCAL-QUEUE-HAPPY-001\",\n330:             \"CR-LOCAL-STATE-HAPPY-PROPOSED-001\"\n331:           ]\n332:         },\n333:         {\n334:           \"storyKey\": \"3-1-create-a-minion-brief-snapshot\",\n335:           \"epic\": 3,\n336:           \"tables\": [\n337:             \"com_councilbrief\"\n338:           ],\n339:           \"columnsByTable\": {\n340:             \"com_councilbrief\": [\n341:               \"com_name\",\n342:               \"com_council_brief_id\",\n343:               \"com_brief_date\",\n344:               \"com_priority_summary\",\n345:               \"com_decisions_needed\",\n346:               \"com_delegations_ready\",\n347:               \"com_risks_if_ignored\",\n348:               \"com_blockers\",\n349:               \"com_recent_receipts\",\n350:               \"com_memory_candidates\"\n351:             ]\n352:           },\n353:           \"relationships\": [],\n354:           \"views\": [],\n355:           \"writeScopeNote\": \"Story 3.1 needs only the Brief table; it must not force Memory or Instruction tables to exist.\",\n356:           \"exampleExistingRows\": []\n357:         },\n358:         {\n359:           \"storyKey\": \"4-1-create-lightweight-meaning-graph-records\",\n360:           \"epic\": 4,\n361:           \"tables\": [\n362:             \"com_councilgraphentity\",\n363:             \"com_councilgraphedge\"\n364:           ],\n365:           \"columnsByTable\": {\n366:             \"com_councilgraphentity\": [\n367:               \"com_name\",\n368:               \"com_council_graph_entity_id\",\n369:               \"com_entity_type\",\n370:               \"com_external_binding_ref\",\n371:               \"com_semantic_contract_version\",\n372:               \"com_status\"\n373:             ],\n374:             \"com_councilgraphedge\": [\n375:               \"com_name\",\n376:               \"com_edge_type\",\n377:               \"com_from_entity\",\n378:               \"com_to_entity\",\n379:               \"com_from_work_item\",\n380:               \"com_source_record\",\n381:               \"com_receipt\"\n382:             ]\n383:           },\n384:           \"relationships\": [\n385:             \"com_councilgraphedge.com_from_entity -> com_councilgraphentity\",\n386:             \"com_councilgraphedge.com_to_entity -> com_councilgraphentity\"\n387:           ],\n388:           \"views\": [],\n389:           \"writeScopeNote\": \"Story 4.1 needs only Graph Entity and Graph Edge tables; it must not force Memory or Instruction tables to exist.\",\n390:           \"exampleExistingRows\": []\n391:         },\n392:         {\n393:           \"storyKey\": \"4-4-promote-approved-instructions-with-receipts\",\n394:           \"epic\": 4,\n395:           \"tables\": [\n396:             \"com_councilmemorycandidate\",\n397:             \"com_councilapprovedinstruction\",\n398:             \"com_councilreceipt\"\n399:           ],\n400:           \"columnsByTable\": {\n401:             \"com_councilmemorycandidate\": [\n402:               \"com_council_memory_candidate_id\",\n403:               \"com_review_state\",\n404:               \"com_review_receipt\"\n405:             ],\n406:             \"com_councilapprovedinstruction\": [\n407:               \"com_council_approved_instruction_id\",\n408:               \"com_instruction_text\",\n409:               \"com_scope\",\n410:               \"com_approval_receipt\",\n411:               \"com_status\",\n412:               \"com_effective_from\",\n413:               \"com_superseded_by\"\n414:             ],\n415:             \"com_councilreceipt\": [\n416:               \"com_receipt_id\",\n417:               \"com_verb\",\n418:               \"com_result\",\n419:               \"com_append_only_locked\"\n420:             ]\n421:           },\n422:           \"relationships\": [\n423:             \"com_councilapprovedinstruction.com_approval_receipt -> com_councilreceipt\",\n424:             \"com_councilapprovedinstruction.com_source_memory_candidate -> com_councilmemorycandidate\"\n425:           ],\n426:           \"views\": [\n427:             \"Memory Receipts\"\n428:           ],\n429:           \"writeScopeNote\": \"Story 4.4 needs Memory Candidate, Approved Instruction, and Receipt tables with the memory_promoted verb; it must not force Skill or Minion tables to exist.\",\n430:           \"exampleExistingRows\": [\n431:             \"CR-LOCAL-MEMORY-001\"\n432:           ]\n433:         }\n434:       ]\n435:     },\n436:     \"rollbackAuditBoundaries\": [\n437:       {\n438:         \"plannedWriteScope\": \"Epic 2 Story 2.3 apply-receipt-backed-queue-state-changes\",\n439:         \"storyKey\": \"2-3-apply-receipt-backed-queue-state-changes\",\n440:         \"writeScopeKey\": \"state-change-mutation\",\n441:         \"rollbackBoundary\": \"Roll back to the last append-only receipt boundary: every com_councilreceipt row is append-only (com_append_only_locked=true), so a failed state-change apply is rolled back by appending a corrective receipt rather than editing or deleting prior rows; the affected com_councilworkitem.com_state_group is restored to the before-state recorded on the failed receipt.\",\n442:         \"auditBoundary\": \"Every state-change write emits a manifest-verb com_councilreceipt with com_before_state, com_after_state, com_idempotency_key, and com_evidence_refs; the receipt is the audit row. No state change is auditably complete without a backing receipt.\",\n443:         \"receiptGate\": \"Live com_councilworkitem.com_state_group mutation is receipt-gated to Epic 2 Story 2.3; no live mutation is performed in this slice.\",\n444:         \"exampleExistingRows\": [\n445:           \"CWI-LOCAL-QUEUE-HAPPY-001\"\n446:         ]\n447:       },\n448:       {\n449:         \"plannedWriteScope\": \"Epic 1 Story 1.5 handle-source-drift-and-supersession live apply\",\n450:         \"storyKey\": \"1-5-handle-source-drift-and-supersession\",\n451:         \"writeScopeKey\": \"source-drift-supersession\",\n452:         \"rollbackBoundary\": \"Roll back to the prior source version: a supersession is reversed by capturing a new superseding record that points com_parent_ref back at the pre-supersession record, never by editing the superseded record or its prior rationale; the superseded record and its receipts stay byte-identical.\",\n453:         \"auditBoundary\": \"Every drift/supersession write emits a source_drifted com_councilreceipt bound to its source evidence by a com_councilreceiptsource row with com_evidence_role=drift_evidence; the drift receipt is the audit row for the version transition.\",\n454:         \"receiptGate\": \"Live com_councilsourcerecord version/supersession mutation is receipt-gated to Epic 2 Story 2.3; no live mutation is performed in this slice.\",\n455:         \"exampleExistingRows\": [\n456:           \"CSR-OUTLOOK-THREAD-MOCK-001\"\n457:         ]\n458:       },\n459:       {\n460:         \"plannedWriteScope\": \"Dataverse MVP schema apply (dataverse-apply-mvp-schema.ps1 with -ExecuteWrites)\",\n461:         \"storyKey\": \"5-5-validate-dataverse-mvp-operational-store-readiness\",\n462:         \"writeScopeKey\": \"schema-apply\",\n463:         \"rollbackBoundary\": \"Roll back the schema apply by deleting the CouncilOfMinionsMVP unmanaged solution in the sandbox environment; unmanaged solution deletion removes the Council tables/choices it introduced. The committed dataverse-mvp-schema-manifest.json is the re-apply source of truth, and the tenant decision packet records Doug's approval before any such apply runs.\",\n464:         \"auditBoundary\": \"The schema apply is gated behind a Doug-approved read-only preflight that proves target.environmentId and target.organizationId match `pac env who`; the preflight evidence and the tenant decision packet are the audit trail for the write authorization. The apply script's DRY RUN ONLY marker is the no-write boundary until approval.\",\n465:         \"receiptGate\": \"The schema apply itself is not a Council receipt event; it is a platform provisioning step approved through the tenant decision packet. It must stay in DRY RUN ONLY mode (writeScriptsDisabled=true) until Doug approves dataverseSandboxWrites and publisherPrefix.\",\n466:         \"exampleExistingRows\": []\n467:       }\n468:     ],\n469:     \"referencedIds\": [\n470:       {\n471:         \"id\": \"CSR-MANUAL-SUMMARY-001\",\n472:         \"idType\": \"CSR\",\n473:         \"sourceSlice\": \"manual-source-record-slice.json\",\n474:         \"referenceRole\": \"example-existing-source-row-in-scope-of-story-1.1-and-2.3-writes\"\n475:       },\n476:       {\n477:         \"id\": \"CSR-MANUAL-MEETING-001\",\n478:         \"idType\": \"CSR\",\n479:         \"sourceSlice\": \"zero-multi-item-extraction-slice.json\",\n480:         \"referenceRole\": \"example-existing-source-row-in-scope-of-story-1.5-drift-writes\"\n481:       },\n482:       {\n483:         \"id\": \"CSR-OUTLOOK-THREAD-MOCK-001\",\n484:         \"idType\": \"CSR\",\n485:         \"sourceSlice\": \"outlook-source-reference-slice.json\",\n486:         \"referenceRole\": \"example-superseded-source-row-in-rollback-boundary-for-story-1.5\"\n487:       },\n488:       {\n489:         \"id\": \"CWI-LOCAL-DECISION-001\",\n490:         \"idType\": \"CWI\",\n491:         \"sourceSlice\": \"proposed-work-item-extraction-slice.json\",\n492:         \"referenceRole\": \"example-existing-work-item-row-in-scope-of-story-1.3-writes\"\n493:       },\n494:       {\n495:         \"id\": \"CWI-LOCAL-SHELL-DECISION-001\",\n496:         \"idType\": \"CWI\",\n497:         \"sourceSlice\": \"work-item-execution-shell-slice.json\",\n498:         \"referenceRole\": \"example-existing-work-item-row-in-scope-of-story-2.1-writes\"\n499:       },\n500:       {\n501:         \"id\": \"CWI-LOCAL-QUEUE-HAPPY-001\",\n502:         \"idType\": \"CWI\",\n503:         \"sourceSlice\": \"receipt-backed-state-changes-slice.json\",\n504:         \"referenceRole\": \"example-existing-work-item-row-in-rollback-boundary-for-story-2.3\"\n505:       },\n506:       {\n507:         \"id\": \"CR-LOCAL-APPROVAL-PROPOSED-001\",\n508:         \"idType\": \"CR\",\n509:         \"sourceSlice\": \"approval-boundaries-slice.json\",\n510:         \"referenceRole\": \"example-existing-receipt-row-in-scope-of-story-1.3-writes\"\n511:       },\n512:       {\n513:         \"id\": \"CR-LOCAL-DRIFT-001\",\n514:         \"idType\": \"CR\",\n515:         \"sourceSlice\": \"source-drift-supersession-slice.json\",\n516:         \"referenceRole\": \"example-existing-receipt-row-in-audit-boundary-for-story-1.5\"\n517:       },\n518:       {\n519:         \"id\": \"CR-LOCAL-SHELL-CREATE-001\",\n520:         \"idType\": \"CR\",\n521:         \"sourceSlice\": \"work-item-execution-shell-slice.json\",\n522:         \"referenceRole\": \"example-existing-receipt-row-in-scope-of-story-2.1-writes\"\n523:       },\n524:       {\n525:         \"id\": \"CR-LOCAL-STATE-HAPPY-PROPOSED-001\",\n526:         \"idType\": \"CR\",\n527:         \"sourceSlice\": \"receipt-backed-state-changes-slice.json\",\n528:         \"referenceRole\": \"example-existing-receipt-row-in-rollback-boundary-for-story-2.3\"\n529:       },\n530:       {\n531:         \"id\": \"CR-LOCAL-MEMORY-001\",\n532:         \"idType\": \"CR\",\n533:         \"sourceSlice\": \"memory-candidates-slice.json\",\n534:         \"referenceRole\": \"example-existing-receipt-row-in-scope-of-story-4.4-writes\"\n535:       }\n536:     ],\n537:     \"writesDeferred\": [\n538:       {\n539:         \"deferredWrite\": \"Live `pac auth who`, `pac env who`, and `pac env list-settings` preflight execution\",\n540:         \"receiptGate\": \"Deferred to a Doug-approved read-only preflight under the Epic 5 tenant-readiness gate; no live pac call is performed in this slice.\",\n541:         \"evidenceState\": \"deferred-to-tenant\"\n542:       },\n543:       {\n544:         \"deferredWrite\": \"dataverse-apply-mvp-schema.ps1 -ExecuteWrites (solution/publisher/choice/table/column/relationship creation and publish)\",\n545:         \"writeScopeKey\": \"schema-apply\",\n546:         \"receiptGate\": \"Deferred until Doug approves dataverseSandboxWrites (allowed_after_readonly_preflight) and confirms publisherPrefix in the tenant decision packet; writeScriptsDisabled stays true in this slice.\",\n547:         \"evidenceState\": \"deferred-to-tenant\"\n548:       },\n549:       {\n550:         \"deferredWrite\": \"Any live com_councilworkitem.com_state_group mutation driven by earlier-slice receipts\",\n551:         \"writeScopeKey\": \"state-change-mutation\",\n552:         \"receiptGate\": \"Receipt-gated to Epic 2 Story 2.3 apply-receipt-backed-queue-state-changes; this slice records the rollback/audit boundary only and performs no live mutation.\",\n553:         \"evidenceState\": \"deferred-to-tenant\"\n554:       },\n555:       {\n556:         \"deferredWrite\": \"Any live com_councilsourcerecord version/supersession mutation driven by earlier-slice drift receipts\",\n557:         \"writeScopeKey\": \"source-drift-supersession\",\n558:         \"receiptGate\": \"Receipt-gated to Epic 2 Story 2.3 apply-receipt-backed-queue-state-changes; this slice records the rollback/audit boundary only and performs no live mutation.\",\n559:         \"evidenceState\": \"deferred-to-tenant\"\n560:       }\n561:     ]\n562:   },\n563:   \"acceptanceMapping\": [\n564:     {\n565:       \"acceptanceCriterion\": 1,\n566:       \"localEvidence\": [\n567:         \"dataverseReadinessRun.preflightContract.expectedCommands lists `pac auth who`, `pac env who`, and `pac env list-settings`, each with an evidenceShape whose every field is the literal 'VERIFY IN TENANT' and evidenceState=deferred-to-tenant; no concrete environment/org id is recorded\",\n568:         \"dataverseReadinessRun.preflightContract.noLivePacCallPerformed=true and guards.noLivePacCallInThisSlice=true and guards.preflightEvidenceDeferredToTenant=true\",\n569:         \"dataverseReadinessRun.pendingApprovals carries dataverseSandboxWrites and publisherPrefix as PENDING entries with requiredApprover=Doug and backingReceiptId=null; guards.writeScriptsDisabled=true (strict) and guards.noApprovalReceiptFabricated=true; no com_receipt_id appears anywhere in the slice\",\n570:         \"dataverseReadinessRun.writesDeferred records the live preflight and the schema apply as deferred entries naming their receipt gates\"\n571:       ],\n572:       \"tenantEvidenceRequired\": \"Live `pac auth who`, `pac env who`, `pac env list-settings` execution and the concrete environment/organization ID match against dataverse-mvp-schema-manifest.json remain VERIFY IN TENANT under the Epic 5 tenant-readiness gate; this slice is local contract evidence only and performs no live pac call.\"\n573:     },\n574:     {\n575:       \"acceptanceCriterion\": 2,\n576:       \"localEvidence\": [\n577:         \"dataverseReadinessRun.dryRunSchemaManifest.manifestRef references the committed dataverse-mvp-schema-manifest.json and guards.fullShapeNotForcedUpfront=true (strict)\",\n578:         \"dataverseReadinessRun.dryRunSchemaManifest.storyScopedWritePolicy is non-empty; every entry references a real epic story key, and every table/column it lists exists in dataverse-mvp-schema-manifest.json\",\n579:         \"dataverseReadinessRun.rollbackAuditBoundaries provides a rollback and an audit boundary statement per planned write scope, each referencing a real epic story key\",\n580:         \"guards.schemaWritesTiedToStoryScope=true and guards.rollbackAuditBoundaryPerPlannedWriteScope=true\"\n581:       ],\n582:       \"tenantEvidenceRequired\": \"Applying story-scoped schema writes to the live tenant (creating only the tables/columns each implementation story needs) remains gated to Doug's sandbox-write approval and the receipt-backed mutation semantics of Epic 2 Story 2.3; this slice records the dry-run mapping and boundaries only and performs no live schema write.\"\n583:     }\n584:   ]\n585: }\n\n(End of file - total 585 lines)\n</content>","metadata":{"preview":"{\n  \"artifactVersion\": \"2026-07-14\",\n  \"storyKey\": \"5-5-validate-dataverse-mvp-operational-store-readiness\",\n  \"status\": \"local-contract-not-tenant-verified\",\n  \"purpose\": \"Prove Dataverse MVP operational store readiness locally as CONTRACT evidence only: a read-only preflight contract describing the expected `pac auth who`, `pac env who`, and environment-settings evidence shape with every tenant value marked VERIFY IN TENANT and deferred-to-tenant; a story-scoped write policy mapping which manifest tables/columns each future implementation story needs (without forcing the full target shape upfront); and rollback/audit boundary statements per planned write scope. Write scripts stay disabled (writeScriptsDisabled=true) until Doug approves Dataverse sandbox writes and publisher prefix; those approvals are present as PENDING entries and no approval receipt is fabricated. No live pac/tenant call is performed in this slice; every would-be live write appears as a deferred entry naming its receipt gate.\",\n  \"guards\": {\n    \"noTenantWrites\": true,\n    \"noOutboundAction\": true,\n    \"writeScriptsDisabled\": true,\n    \"preflightEvidenceDeferredToTenant\": true,\n    \"noApprovalReceiptFabricated\": true,\n    \"fullShapeNotForcedUpfront\": true,\n    \"schemaWritesTiedToStoryScope\": true,\n    \"rollbackAuditBoundaryPerPlannedWriteScope\": true,\n    \"receiptsAreLocalContractEvidenceOnly\": true,\n    \"noLivePacCallInThisSlice\": true\n  },\n  \"dataverseReadinessRun\": {\n    \"runId\": \"READINESS-LOCAL-2026-07-14-001\",\n    \"actorType\": \"system\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/doug/.ringer/work/bmad-hybrid/5-5-validate-dataverse-mvp-operational-store-readiness/_bmad-output/implementation-artifacts/dataverse-readiness-slice.json","text":"{\n  \"artifactVersion\": \"2026-07-14\",\n  \"storyKey\": \"5-5-validate-dataverse-mvp-operational-store-readiness\",\n  \"status\": \"local-contract-not-tenant-verified\",\n  \"purpose\": \"Prove Dataverse MVP operational store readiness locally as CONTRACT evidence only: a read-only preflight contract describing the expected `pac auth who`, `pac env who`, and environment-settings evidence shape with every tenant value marked VERIFY IN TENANT and deferred-to-tenant; a story-scoped write policy mapping which manifest tables/columns each future implementation story needs (without forcing the full target shape upfront); and rollback/audit boundary statements per planned write scope. Write scripts stay disabled (writeScriptsDisabled=true) until Doug approves Dataverse sandbox writes and publisher prefix; those approvals are present as PENDING entries and no approval receipt is fabricated. No live pac/tenant call is performed in this slice; every would-be live write appears as a deferred entry naming its receipt gate.\",\n  \"guards\": {\n    \"noTenantWrites\": true,\n    \"noOutboundAction\": true,\n    \"writeScriptsDisabled\": true,\n    \"preflightEvidenceDeferredToTenant\": true,\n    \"noApprovalReceiptFabricated\": true,\n    \"fullShapeNotForcedUpfront\": true,\n    \"schemaWritesTiedToStoryScope\": true,\n    \"rollbackAuditBoundaryPerPlannedWriteScope\": true,\n    \"receiptsAreLocalContractEvidenceOnly\": true,\n    \"noLivePacCallInThisSlice\": true\n  },\n  \"dataverseReadinessRun\": {\n    \"runId\": \"READINESS-LOCAL-2026-07-14-001\",\n    \"actorType\": \"system\",\n    \"actorId\": \"local-bmad-validator\",\n    \"authorityBasis\": \"local non-tenant Story 5.5 contract validation; no live pac call and no tenant write performed\",\n    \"semanticContractVersion\": \"2026-07-07\",\n    \"inputManifestRef\": \"dataverse-mvp-schema-manifest.json\",\n    \"inputDecisionPacketRef\": \"tenant-decision-packet.json\",\n    \"inputSprintStatusRef\": \"sprint-status.yaml\",\n    \"inputSourceRecordsFrom\": [\n      \"manual-source-record-slice.json\",\n      \"outlook-source-reference-slice.json\",\n      \"proposed-work-item-extraction-slice.json\",\n      \"zero-multi-item-extraction-slice.json\",\n      \"source-drift-supersession-slice.json\"\n    ],\n    \"decisionPolicy\": {\n      \"preflightMustProveExpectedEnvironmentAndOrganizationBeforeAnyWrite\": true,\n      \"writeScriptsStayDisabledUntilDougApprovesSandboxWritesAndPublisherPrefix\": true,\n      \"noApprovalReceiptIsFabricatedWhileApprovalsArePending\": true,\n      \"schemaWritesTiedToCurrentStoryNeededTablesColumnsRelationshipsViews\": true,\n      \"dryRunManifestMayDescribeFullTargetShapeWithoutForcingItUpfront\": true,\n      \"rollbackAndAuditBoundaryStatedPerPlannedWriteScope\": true,\n      \"liveDataverseMutationReceiptGatedToEpic2Story23\": true,\n      \"receiptsAreLocalContractEvidenceOnly\": true\n    },\n    \"preflightContract\": {\n      \"evidenceState\": \"deferred-to-tenant\",\n      \"verificationMarker\": \"VERIFY IN TENANT\",\n      \"noLivePacCallPerformed\": true,\n      \"expectedCommands\": [\n        {\n          \"command\": \"pac auth who\",\n          \"purpose\": \"Prove the authenticated user context that would issue any future write.\",\n          \"evidenceShape\": {\n            \"userContextUPN\": \"VERIFY IN TENANT\",\n            \"loggedInUser\": \"VERIFY IN TENANT\",\n            \"tenantId\": \"VERIFY IN TENANT\"\n          },\n          \"evidenceState\": \"deferred-to-tenant\",\n          \"deferredTo\": \"Epic 5 tenant-readiness gate; live run of `pac auth who` is receipt-gated to a Doug-approved read-only preflight\"\n        },\n        {\n          \"command\": \"pac env who\",\n          \"purpose\": \"Prove the target environment ID, environment name, organization ID, and environment URL match the committed manifest target before any write.\",\n          \"evidenceShape\": {\n            \"environmentId\": \"VERIFY IN TENANT\",\n            \"environmentName\": \"VERIFY IN TENANT\",\n            \"organizationId\": \"VERIFY IN TENANT\",\n            \"environmentUrl\": \"VERIFY IN TENANT\"\n          },\n          \"evidenceState\": \"deferred-to-tenant\",\n          \"deferredTo\": \"Epic 5 tenant-readiness gate; live `pac env who` match against dataverse-mvp-schema-manifest.json target is receipt-gated to a Doug-approved read-only preflight\"\n        },\n        {\n          \"command\": \"pac env list-settings\",\n          \"purpose\": \"Capture environment settings evidence (organization settings, admin mode, throttle status) as read-only context for the readiness decision.\",\n          \"evidenceShape\": {\n            \"organizationSettings\": \"VERIFY IN TENANT\",\n            \"settingsHash\": \"VERIFY IN TENANT\",\n            \"adminMode\": \"VERIFY IN TENANT\"\n          },\n          \"evidenceState\": \"deferred-to-tenant\",\n          \"deferredTo\": \"Epic 5 tenant-readiness gate; live `pac env list-settings` capture is receipt-gated to a Doug-approved read-only preflight\"\n        }\n      ],\n      \"matchPolicy\": \"When the live preflight runs, the `pac env who` environment ID and organization ID MUST equal dataverse-mvp-schema-manifest.json target.environmentId and target.organizationId; a mismatch blocks every write. This slice records the expected SHAPE only and defers the concrete values to the tenant; no concrete environment or organization id is recorded here.\"\n    },\n    \"pendingApprovals\": [\n      {\n        \"approvalEntryId\": \"APPR-LOCAL-DV-SANDBOX-WRITES-001\",\n        \"decision\": \"dataverseSandboxWrites\",\n        \"requiredBefore\": \"dataverse-write\",\n        \"state\": \"PENDING\",\n        \"requiredApprover\": \"Doug\",\n        \"question\": \"Are Dataverse sandbox writes allowed after read-only preflight proves the target environment?\",\n        \"allowedValues\": [\n          \"forbidden\",\n          \"allowed_after_readonly_preflight\"\n        ],\n        \"receiptGate\": \"No approval receipt (CR-LOCAL-*) is fabricated for this approval until Doug explicitly approves; dataverse-apply-mvp-schema.ps1 must stay in DRY RUN ONLY mode and writeScriptsDisabled stays true.\",\n        \"writeScriptsDisabledUntilApproved\": true,\n        \"backingReceiptId\": null\n      },\n      {\n        \"approvalEntryId\": \"APPR-LOCAL-PUBLISHER-PREFIX-001\",\n        \"decision\": \"publisherPrefix\",\n        \"requiredBefore\": \"solution-creation\",\n        \"state\": \"PENDING\",\n        \"requiredApprover\": \"Doug\",\n        \"question\": \"What Dataverse publisher prefix should confirm the placeholder prefix before any solution creation write?\",\n        \"allowedValues\": [\n          \"com\"\n        ],\n        \"receiptGate\": \"No approval receipt (CR-LOCAL-*) is fabricated for this approval until Doug confirms the publisher prefix; publisher/solution creation writes stay disabled.\",\n        \"writeScriptsDisabledUntilApproved\": true,\n        \"backingReceiptId\": null\n      }\n    ],\n    \"dryRunSchemaManifest\": {\n      \"manifestRef\": \"dataverse-mvp-schema-manifest.json\",\n      \"manifestVersion\": \"2026-07-08\",\n      \"fullShapeNotForcedUpfront\": true,\n      \"fullShapeDescription\": \"dataverse-mvp-schema-manifest.json describes the full MVP target shape (14 tables, 15 global choices, model-driven app, sitemap). The dry run MAY reference the full shape for planning, but no implementation story is allowed to force all tables/columns to be created before that story needs them.\",\n      \"storyScopedWritePolicy\": [\n        {\n          \"storyKey\": \"1-1-capture-manual-source-records\",\n          \"epic\": 1,\n          \"tables\": [\n            \"com_councilsourcerecord\"\n          ],\n          \"columnsByTable\": {\n            \"com_councilsourcerecord\": [\n              \"com_name\",\n              \"com_council_source_record_id\",\n              \"com_source_system\",\n              \"com_source_kind\",\n              \"com_source_object_ref\",\n              \"com_captured_at\",\n              \"com_captured_by\",\n              \"com_extraction_status\",\n              \"com_source_to_work_item_rationale\",\n              \"com_data_boundary_policy\"\n            ]\n          },\n          \"relationships\": [],\n          \"views\": [\n            \"New Source Records\"\n          ],\n          \"writeScopeNote\": \"Story 1.1 only needs the Source Record table and its capture/boundary columns; it must not force Work Item or Receipt tables to exist.\",\n          \"exampleExistingRows\": [\n            \"CSR-MANUAL-SUMMARY-001\"\n          ]\n        },\n        {\n          \"storyKey\": \"1-3-extract-proposed-work-items-from-source-records\",\n          \"epic\": 1,\n          \"tables\": [\n            \"com_councilworkitem\",\n            \"com_councilworkitemsource\",\n            \"com_councilreceipt\"\n          ],\n          \"columnsByTable\": {\n            \"com_councilworkitem\": [\n              \"com_title\",\n              \"com_council_work_item_id\",\n              \"com_type\",\n              \"com_summary\",\n              \"com_state_group\",\n              \"com_risk_class\",\n              \"com_primary_source_record\",\n              \"com_rationale\",\n              \"com_approval_required\",\n              \"com_semantic_contract_version\"\n            ],\n            \"com_councilworkitemsource\": [\n              \"com_name\",\n              \"com_work_item\",\n              \"com_source_record\",\n              \"com_source_role\"\n            ],\n            \"com_councilreceipt\": [\n              \"com_receipt_id\",\n              \"com_work_item\",\n              \"com_verb\",\n              \"com_actor_type\",\n              \"com_actor_id\",\n              \"com_authority_basis\",\n              \"com_occurred_at\",\n              \"com_idempotency_key\",\n              \"com_result\",\n              \"com_append_only_locked\"\n            ]\n          },\n          \"relationships\": [\n            \"com_councilworkitem.com_primary_source_record -> com_councilsourcerecord\",\n            \"com_councilworkitemsource.com_work_item -> com_councilworkitem\",\n            \"com_councilworkitemsource.com_source_record -> com_councilsourcerecord\"\n          ],\n          \"views\": [\n            \"Proposed Work Items\"\n          ],\n          \"writeScopeNote\": \"Story 1.3 needs Work Item, Work Item Source, and Receipt tables with the proposed verb only; it must not force Graph or Memory tables to exist.\",\n          \"exampleExistingRows\": [\n            \"CWI-LOCAL-DECISION-001\",\n            \"CR-LOCAL-APPROVAL-PROPOSED-001\"\n          ]\n        },\n        {\n          \"storyKey\": \"1-5-handle-source-drift-and-supersession\",\n          \"epic\": 1,\n          \"tables\": [\n            \"com_councilsourcerecord\",\n            \"com_councilreceipt\",\n            \"com_councilreceiptsource\"\n          ],\n          \"columnsByTable\": {\n            \"com_councilsourcerecord\": [\n              \"com_council_source_record_id\",\n              \"com_parent_ref\",\n              \"com_source_version_ref\",\n              \"com_content_hash\",\n              \"com_observed_modified_at\",\n              \"com_extraction_status\"\n            ],\n            \"com_councilreceipt\": [\n              \"com_receipt_id\",\n              \"com_verb\",\n              \"com_before_state\",\n              \"com_after_state\",\n              \"com_evidence_refs\",\n              \"com_idempotency_key\",\n              \"com_append_only_locked\"\n            ],\n            \"com_councilreceiptsource\": [\n              \"com_name\",\n              \"com_receipt\",\n              \"com_source_record\",\n              \"com_evidence_role\"\n            ]\n          },\n          \"relationships\": [\n            \"com_councilreceiptsource.com_receipt -> com_councilreceipt\",\n            \"com_councilreceiptsource.com_source_record -> com_councilsourcerecord\"\n          ],\n          \"views\": [\n            \"Source Records With Drift Risk\"\n          ],\n          \"writeScopeNote\": \"Story 1.5 needs the source_drifted verb on Receipt and the drift_evidence role on Receipt Source; it must not force Work Item state columns to change.\",\n          \"exampleExistingRows\": [\n            \"CSR-MANUAL-MEETING-001\",\n            \"CR-LOCAL-DRIFT-001\"\n          ]\n        },\n        {\n          \"storyKey\": \"2-1-maintain-the-work-item-execution-shell\",\n          \"epic\": 2,\n          \"tables\": [\n            \"com_councilworkitem\",\n            \"com_councilreceipt\"\n          ],\n          \"columnsByTable\": {\n            \"com_councilworkitem\": [\n              \"com_council_work_item_id\",\n              \"com_state_group\",\n              \"com_owner_candidate\",\n              \"com_approved_owner\",\n              \"com_urgency\",\n              \"com_recommended_next_action\",\n              \"com_created_receipt\"\n            ],\n            \"com_councilreceipt\": [\n              \"com_receipt_id\",\n              \"com_work_item\",\n              \"com_verb\",\n              \"com_occurred_at\",\n              \"com_idempotency_key\",\n              \"com_append_only_locked\"\n            ]\n          },\n          \"relationships\": [\n            \"com_councilworkitem.com_created_receipt -> com_councilreceipt\"\n          ],\n          \"views\": [\n            \"Needs Human Approval\"\n          ],\n          \"writeScopeNote\": \"Story 2.1 needs the Work Item execution shell columns and the proposed-verb receipt chain; it must not force approval-scope columns to mutate.\",\n          \"exampleExistingRows\": [\n            \"CWI-LOCAL-SHELL-DECISION-001\",\n            \"CR-LOCAL-SHELL-CREATE-001\"\n          ]\n        },\n        {\n          \"storyKey\": \"2-3-apply-receipt-backed-queue-state-changes\",\n          \"epic\": 2,\n          \"tables\": [\n            \"com_councilworkitem\",\n            \"com_councilreceipt\",\n            \"com_councilreceiptsource\"\n          ],\n          \"columnsByTable\": {\n            \"com_councilworkitem\": [\n              \"com_council_work_item_id\",\n              \"com_state_group\"\n            ],\n            \"com_councilreceipt\": [\n              \"com_receipt_id\",\n              \"com_work_item\",\n              \"com_verb\",\n              \"com_before_state\",\n              \"com_after_state\",\n              \"com_idempotency_key\",\n              \"com_result\",\n              \"com_append_only_locked\"\n            ],\n            \"com_councilreceiptsource\": [\n              \"com_receipt\",\n              \"com_source_record\",\n              \"com_evidence_role\"\n            ]\n          },\n          \"relationships\": [\n            \"com_councilreceipt.com_work_item -> com_councilworkitem\"\n          ],\n          \"views\": [\n            \"In Review\",\n            \"Completed Recently\",\n            \"Failed Needs Review\"\n          ],\n          \"writeScopeNote\": \"Story 2.3 is the canonical receipt-backed mutation story; every live Dataverse mutation from earlier slices is gated to this story. It needs only the state-change columns and the receipt verbs it exercises.\",\n          \"exampleExistingRows\": [\n            \"CWI-LOCAL-QUEUE-HAPPY-001\",\n            \"CR-LOCAL-STATE-HAPPY-PROPOSED-001\"\n          ]\n        },\n        {\n          \"storyKey\": \"3-1-create-a-minion-brief-snapshot\",\n          \"epic\": 3,\n          \"tables\": [\n            \"com_councilbrief\"\n          ],\n          \"columnsByTable\": {\n            \"com_councilbrief\": [\n              \"com_name\",\n              \"com_council_brief_id\",\n              \"com_brief_date\",\n              \"com_priority_summary\",\n              \"com_decisions_needed\",\n              \"com_delegations_ready\",\n              \"com_risks_if_ignored\",\n              \"com_blockers\",\n              \"com_recent_receipts\",\n              \"com_memory_candidates\"\n            ]\n          },\n          \"relationships\": [],\n          \"views\": [],\n          \"writeScopeNote\": \"Story 3.1 needs only the Brief table; it must not force Memory or Instruction tables to exist.\",\n          \"exampleExistingRows\": []\n        },\n        {\n          \"storyKey\": \"4-1-create-lightweight-meaning-graph-records\",\n          \"epic\": 4,\n          \"tables\": [\n            \"com_councilgraphentity\",\n            \"com_councilgraphedge\"\n          ],\n          \"columnsByTable\": {\n            \"com_councilgraphentity\": [\n              \"com_name\",\n              \"com_council_graph_entity_id\",\n              \"com_entity_type\",\n              \"com_external_binding_ref\",\n              \"com_semantic_contract_version\",\n              \"com_status\"\n            ],\n            \"com_councilgraphedge\": [\n              \"com_name\",\n              \"com_edge_type\",\n              \"com_from_entity\",\n              \"com_to_entity\",\n              \"com_from_work_item\",\n              \"com_source_record\",\n              \"com_receipt\"\n            ]\n          },\n          \"relationships\": [\n            \"com_councilgraphedge.com_from_entity -> com_councilgraphentity\",\n            \"com_councilgraphedge.com_to_entity -> com_councilgraphentity\"\n          ],\n          \"views\": [],\n          \"writeScopeNote\": \"Story 4.1 needs only Graph Entity and Graph Edge tables; it must not force Memory or Instruction tables to exist.\",\n          \"exampleExistingRows\": []\n        },\n        {\n          \"storyKey\": \"4-4-promote-approved-instructions-with-receipts\",\n          \"epic\": 4,\n          \"tables\": [\n            \"com_councilmemorycandidate\",\n            \"com_councilapprovedinstruction\",\n            \"com_councilreceipt\"\n          ],\n          \"columnsByTable\": {\n            \"com_councilmemorycandidate\": [\n              \"com_council_memory_candidate_id\",\n              \"com_review_state\",\n              \"com_review_receipt\"\n            ],\n            \"com_councilapprovedinstruction\": [\n              \"com_council_approved_instruction_id\",\n              \"com_instruction_text\",\n              \"com_scope\",\n              \"com_approval_receipt\",\n              \"com_status\",\n              \"com_effective_from\",\n              \"com_superseded_by\"\n            ],\n            \"com_councilreceipt\": [\n              \"com_receipt_id\",\n              \"com_verb\",\n              \"com_result\",\n              \"com_append_only_locked\"\n            ]\n          },\n          \"relationships\": [\n            \"com_councilapprovedinstruction.com_approval_receipt -> com_councilreceipt\",\n            \"com_councilapprovedinstruction.com_source_memory_candidate -> com_councilmemorycandidate\"\n          ],\n          \"views\": [\n            \"Memory Receipts\"\n          ],\n          \"writeScopeNote\": \"Story 4.4 needs Memory Candidate, Approved Instruction, and Receipt tables with the memory_promoted verb; it must not force Skill or Minion tables to exist.\",\n          \"exampleExistingRows\": [\n            \"CR-LOCAL-MEMORY-001\"\n          ]\n        }\n      ]\n    },\n    \"rollbackAuditBoundaries\": [\n      {\n        \"plannedWriteScope\": \"Epic 2 Story 2.3 apply-receipt-backed-queue-state-changes\",\n        \"storyKey\": \"2-3-apply-receipt-backed-queue-state-changes\",\n        \"writeScopeKey\": \"state-change-mutation\",\n        \"rollbackBoundary\": \"Roll back to the last append-only receipt boundary: every com_councilreceipt row is append-only (com_append_only_locked=true), so a failed state-change apply is rolled back by appending a corrective receipt rather than editing or deleting prior rows; the affected com_councilworkitem.com_state_group is restored to the before-state recorded on the failed receipt.\",\n        \"auditBoundary\": \"Every state-change write emits a manifest-verb com_councilreceipt with com_before_state, com_after_state, com_idempotency_key, and com_evidence_refs; the receipt is the audit row. No state change is auditably complete without a backing receipt.\",\n        \"receiptGate\": \"Live com_councilworkitem.com_state_group mutation is receipt-gated to Epic 2 Story 2.3; no live mutation is performed in this slice.\",\n        \"exampleExistingRows\": [\n          \"CWI-LOCAL-QUEUE-HAPPY-001\"\n        ]\n      },\n      {\n        \"plannedWriteScope\": \"Epic 1 Story 1.5 handle-source-drift-and-supersession live apply\",\n        \"storyKey\": \"1-5-handle-source-drift-and-supersession\",\n        \"writeScopeKey\": \"source-drift-supersession\",\n        \"rollbackBoundary\": \"Roll back to the prior source version: a supersession is reversed by capturing a new superseding record that points com_parent_ref back at the pre-supersession record, never by editing the superseded record or its prior rationale; the superseded record and its receipts stay byte-identical.\",\n        \"auditBoundary\": \"Every drift/supersession write emits a source_drifted com_councilreceipt bound to its source evidence by a com_councilreceiptsource row with com_evidence_role=drift_evidence; the drift receipt is the audit row for the version transition.\",\n        \"receiptGate\": \"Live com_councilsourcerecord version/supersession mutation is receipt-gated to Epic 2 Story 2.3; no live mutation is performed in this slice.\",\n        \"exampleExistingRows\": [\n          \"CSR-OUTLOOK-THREAD-MOCK-001\"\n        ]\n      },\n      {\n        \"plannedWriteScope\": \"Dataverse MVP schema apply (dataverse-apply-mvp-schema.ps1 with -ExecuteWrites)\",\n        \"storyKey\": \"5-5-validate-dataverse-mvp-operational-store-readiness\",\n        \"writeScopeKey\": \"schema-apply\",\n        \"rollbackBoundary\": \"Roll back the schema apply by deleting the CouncilOfMinionsMVP unmanaged solution in the sandbox environment; unmanaged solution deletion removes the Council tables/choices it introduced. The committed dataverse-mvp-schema-manifest.json is the re-apply source of truth, and the tenant decision packet records Doug's approval before any such apply runs.\",\n        \"auditBoundary\": \"The schema apply is gated behind a Doug-approved read-only preflight that proves target.environmentId and target.organizationId match `pac env who`; the preflight evidence and the tenant decision packet are the audit trail for the write authorization. The apply script's DRY RUN ONLY marker is the no-write boundary until approval.\",\n        \"receiptGate\": \"The schema apply itself is not a Council receipt event; it is a platform provisioning step approved through the tenant decision packet. It must stay in DRY RUN ONLY mode (writeScriptsDisabled=true) until Doug approves dataverseSandboxWrites and publisherPrefix.\",\n        \"exampleExistingRows\": []\n      }\n    ],\n    \"referencedIds\": [\n      {\n        \"id\": \"CSR-MANUAL-SUMMARY-001\",\n        \"idType\": \"CSR\",\n        \"sourceSlice\": \"manual-source-record-slice.json\",\n        \"referenceRole\": \"example-existing-source-row-in-scope-of-story-1.1-and-2.3-writes\"\n      },\n      {\n        \"id\": \"CSR-MANUAL-MEETING-001\",\n        \"idType\": \"CSR\",\n        \"sourceSlice\": \"zero-multi-item-extraction-slice.json\",\n        \"referenceRole\": \"example-existing-source-row-in-scope-of-story-1.5-drift-writes\"\n      },\n      {\n        \"id\": \"CSR-OUTLOOK-THREAD-MOCK-001\",\n        \"idType\": \"CSR\",\n        \"sourceSlice\": \"outlook-source-reference-slice.json\",\n        \"referenceRole\": \"example-superseded-source-row-in-rollback-boundary-for-story-1.5\"\n      },\n      {\n        \"id\": \"CWI-LOCAL-DECISION-001\",\n        \"idType\": \"CWI\",\n        \"sourceSlice\": \"proposed-work-item-extraction-slice.json\",\n        \"referenceRole\": \"example-existing-work-item-row-in-scope-of-story-1.3-writes\"\n      },\n      {\n        \"id\": \"CWI-LOCAL-SHELL-DECISION-001\",\n        \"idType\": \"CWI\",\n        \"sourceSlice\": \"work-item-execution-shell-slice.json\",\n        \"referenceRole\": \"example-existing-work-item-row-in-scope-of-story-2.1-writes\"\n      },\n      {\n        \"id\": \"CWI-LOCAL-QUEUE-HAPPY-001\",\n        \"idType\": \"CWI\",\n        \"sourceSlice\": \"receipt-backed-state-changes-slice.json\",\n        \"referenceRole\": \"example-existing-work-item-row-in-rollback-boundary-for-story-2.3\"\n      },\n      {\n        \"id\": \"CR-LOCAL-APPROVAL-PROPOSED-001\",\n        \"idType\": \"CR\",\n        \"sourceSlice\": \"approval-boundaries-slice.json\",\n        \"referenceRole\": \"example-existing-receipt-row-in-scope-of-story-1.3-writes\"\n      },\n      {\n        \"id\": \"CR-LOCAL-DRIFT-001\",\n        \"idType\": \"CR\",\n        \"sourceSlice\": \"source-drift-supersession-slice.json\",\n        \"referenceRole\": \"example-existing-receipt-row-in-audit-boundary-for-story-1.5\"\n      },\n      {\n        \"id\": \"CR-LOCAL-SHELL-CREATE-001\",\n        \"idType\": \"CR\",\n        \"sourceSlice\": \"work-item-execution-shell-slice.json\",\n        \"referenceRole\": \"example-existing-receipt-row-in-scope-of-story-2.1-writes\"\n      },\n      {\n        \"id\": \"CR-LOCAL-STATE-HAPPY-PROPOSED-001\",\n        \"idType\": \"CR\",\n        \"sourceSlice\": \"receipt-backed-state-changes-slice.json\",\n        \"referenceRole\": \"example-existing-receipt-row-in-rollback-boundary-for-story-2.3\"\n      },\n      {\n        \"id\": \"CR-LOCAL-MEMORY-001\",\n        \"idType\": \"CR\",\n        \"sourceSlice\": \"memory-candidates-slice.json\",\n        \"referenceRole\": \"example-existing-receipt-row-in-scope-of-story-4.4-writes\"\n      }\n    ],\n    \"writesDeferred\": [\n      {\n        \"deferredWrite\": \"Live `pac auth who`, `pac env who`, and `pac env list-settings` preflight execution\",\n        \"receiptGate\": \"Deferred to a Doug-approved read-only preflight under the Epic 5 tenant-readiness gate; no live pac call is performed in this slice.\",\n        \"evidenceState\": \"deferred-to-tenant\"\n      },\n      {\n        \"deferredWrite\": \"dataverse-apply-mvp-schema.ps1 -ExecuteWrites (solution/publisher/choice/table/column/relationship creation and publish)\",\n        \"writeScopeKey\": \"schema-apply\",\n        \"receiptGate\": \"Deferred until Doug approves dataverseSandboxWrites (allowed_after_readonly_preflight) and confirms publisherPrefix in the tenant decision packet; writeScriptsDisabled stays true in this slice.\",\n        \"evidenceState\": \"deferred-to-tenant\"\n      },\n      {\n        \"deferredWrite\": \"Any live com_councilworkitem.com_state_group mutation driven by earlier-slice receipts\",\n        \"writeScopeKey\": \"state-change-mutation\",\n        \"receiptGate\": \"Receipt-gated to Epic 2 Story 2.3 apply-receipt-backed-queue-state-changes; this slice records the rollback/audit boundary only and performs no live mutation.\",\n        \"evidenceState\": \"deferred-to-tenant\"\n      },\n      {\n        \"deferredWrite\": \"Any live com_councilsourcerecord version/supersession mutation driven by earlier-slice drift receipts\",\n        \"writeScopeKey\": \"source-drift-supersession\",\n        \"receiptGate\": \"Receipt-gated to Epic 2 Story 2.3 apply-receipt-backed-queue-state-changes; this slice records the rollback/audit boundary only and performs no live mutation.\",\n        \"evidenceState\": \"deferred-to-tenant\"\n      }\n    ]\n  },\n  \"acceptanceMapping\": [\n    {\n      \"acceptanceCriterion\": 1,\n      \"localEvidence\": [\n        \"dataverseReadinessRun.preflightContract.expectedCommands lists `pac auth who`, `pac env who`, and `pac env list-settings`, each with an evidenceShape whose every field is the literal 'VERIFY IN TENANT' and evidenceState=deferred-to-tenant; no concrete environment/org id is recorded\",\n        \"dataverseReadinessRun.preflightContract.noLivePacCallPerformed=true and guards.noLivePacCallInThisSlice=true and guards.preflightEvidenceDeferredToTenant=true\",\n        \"dataverseReadinessRun.pendingApprovals carries dataverseSandboxWrites and publisherPrefix as PENDING entries with requiredApprover=Doug and backingReceiptId=null; guards.writeScriptsDisabled=true (strict) and guards.noApprovalReceiptFabricated=true; no com_receipt_id appears anywhere in the slice\",\n        \"dataverseReadinessRun.writesDeferred records the live preflight and the schema apply as deferred entries naming their receipt gates\"\n      ],\n      \"tenantEvidenceRequired\": \"Live `pac auth who`, `pac env who`, `pac env list-settings` execution and the concrete environment/organization ID match against dataverse-mvp-schema-manifest.json remain VERIFY IN TENANT under the Epic 5 tenant-readiness gate; this slice is local contract evidence only and performs no live pac call.\"\n    },\n    {\n      \"acceptanceCriterion\": 2,\n      \"localEvidence\": [\n        \"dataverseReadinessRun.dryRunSchemaManifest.manifestRef references the committed dataverse-mvp-schema-manifest.json and guards.fullShapeNotForcedUpfront=true (strict)\",\n        \"dataverseReadinessRun.dryRunSchemaManifest.storyScopedWritePolicy is non-empty; every entry references a real epic story key, and every table/column it lists exists in dataverse-mvp-schema-manifest.json\",\n        \"dataverseReadinessRun.rollbackAuditBoundaries provides a rollback and an audit boundary statement per planned write scope, each referencing a real epic story key\",\n        \"guards.schemaWritesTiedToStoryScope=true and guards.rollbackAuditBoundaryPerPlannedWriteScope=true\"\n      ],\n      \"tenantEvidenceRequired\": \"Applying story-scoped schema writes to the live tenant (creating only the tables/columns each implementation story needs) remains gated to Doug's sandbox-write approval and the receipt-backed mutation semantics of Epic 2 Story 2.3; this slice records the dry-run mapping and boundaries only and performs no live schema write.\"\n    }\n  ]\n}","lineStart":1,"lineEnd":585,"totalLines":585,"truncated":false}},"title":"_bmad-output/impleme