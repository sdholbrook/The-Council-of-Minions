rseRowsNotUsedAsCouncilIdentity\": true,\n    \"receiptsAreLocalContractEvidenceOnly\": true,\n    \"receiptsAreAppendOnlyCorrectionsAreNewReceipts\": true,\n    \"authorityExpansionRequiresExplicitApprovalReceipt\": true,\n    \"activationStrictlyFollowsApprovalReceipt\": true,\n    \"denialConstrainsSkillToBeforeAuthority\": true,\n    \"denialRationaleRemainsVisibleForFutureReview\": true,\n    \"noWorkItemStateChangeInThisSlice\": true\n  },\n  \"authoritySetVocabulary\": {\n    \"basis\": \"Manifest com_councilskill has no explicit authority-set column: com_authority_class is a single choice (manual_only/ask_before_use/approved_automatic) and com_allowed_context/com_required_inputs are free multiline text. This slice models an authority set as a Story 5.2 local extension comprising authorityClass, dataScopes, tools, and externalActions, projecting onto com_authority_class plus com_allowed_context. Authority-set members are reproducible local-contract identifiers (for example dataverse.com_councilworkitem.read, email.send), not tenant enum values; adopting them as tenant-wide choice values is a deferred, receipt-gated decision for Epic 2. This is a documented local extension, NOT a claim that the meaning graph owns skill workflow state; guards.meaningGraphDoesNotOwnWorkflowState and guards.noWorkItemStateChangeInThisSlice remain true.\",\n    \"expansionTriggersApproval\": [\n      \"add_data_scope\",\n      \"add_tool_use\",\n      \"add_external_action\",\n      \"broaden_authority_class\"\n    ],\n    \"nonExpandingChanges\": [\n      \"clarify_trigger\",\n      \"fix_proof_owed_text\",\n      \"narrow_authority_class\"\n    ]\n  },\n  \"failureCodeVocabulary\": {\n    \"basis\": \"Manifest com_councilreceipt.com_failure_code is a free-text column with no enumerated choice set, so this slice declares a Story 5.2 local extension naming the denial code used here together with its kind, retry allowance, and human-review semantics. Codes are reproducible local-contract identifiers, not tenant enums; adopting them as tenant-wide choice values is a deferred, receipt-gated decision for Epic 2.\",\n    \"codes\": [\n      {\n        \"code\": \"skill_authority_expansion_denied\",\n        \"kind\": \"policy_denial\",\n        \"retryAllowed\": false,\n        \"humanReviewRequired\": true,\n        \"definition\": \"A proposed Skill authority expansion that adds data access, tool use, external action, or a broader authority class was denied because it failed the human-approval or scope-breadth gate (FR25/FR13). The skill remains inactive or constrained to its before authority set; the denial is non-retryable without a policy change or a re-scoped proposal, and the rationale stays visible for future review.\"\n      }\n    ]\n  },\n  \"expansionRun\": {\n    \"runId\": \"SKILL-LOCAL-2026-07-14-001\",\n    \"actorType\": \"human\",\n    \"actorId\": \"Doug\",\n    \"authorityBasis\": \"local non-tenant Story 5.2 contract validation; skill authority expansion is receipt-gated and any live write stays deferred to Epic 2\",\n    \"semanticContractVersion\": \"2026-07-07\",\n    \"inputSlicesFrom\": [\n      \"manual-source-record-slice.json\",\n      \"outlook-source-reference-slice.json\"\n    ],\n    \"decisionPolicy\": {\n      \"authorityExpansionRequiresExplicitHumanApprovalReceipt\": true,\n      \"activationStrictlyFollowsAnApprovalReceiptNotAFlag\": true,\n      \"denialConstrainsTheSkillToItsBeforeAuthoritySet\": true,\n      \"denialRationaleRemainsVisibleForFutureReview\": true,\n      \"beforeAndAfterAuthoritySetsDifferExactlyByTheDeclaredDelta\": true,\n      \"liveSkillMutationReceiptGatedToEpic2\": true,\n      \"receiptsAreAppendOnlyCorrectionsAreNewReceipts\": true\n    },\n    \"skills\": [\n      {\n        \"evidenceStatus\": \"mock_manual_not_tenant_verified\",\n        \"skillRecord\": {\n          \"com_name\": \"Daily meeting digest skill (proposed, candidate)\",\n          \"com_council_skill_id\": \"CSK-LOC