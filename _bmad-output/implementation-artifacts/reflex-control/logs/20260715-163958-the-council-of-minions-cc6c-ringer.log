[],\n389:           \"writeScopeNote\": \"Story 4.1 needs only Graph Entity and Graph Edge tables; it must not force Memory or Instruction tables to exist.\",\n390:           \"exampleExistingRows\": []\n391:         },\n392:         {\n393:           \"storyKey\": \"4-4-promote-approved-instructions-with-receipts\",\n394:           \"epic\": 4,\n395:           \"tables\": [\n396:             \"com_councilmemorycandidate\",\n397:             \"com_councilapprovedinstruction\",\n398:             \"com_councilreceipt\"\n399:           ],\n400:           \"columnsByTable\": {\n401:             \"com_councilmemorycandidate\": [\n402:               \"com_council_memory_candidate_id\",\n403:               \"com_review_state\",\n404:               \"com_review_receipt\"\n405:             ],\n406:             \"com_councilapprovedinstruction\": [\n407:               \"com_council_approved_instruction_id\",\n408:               \"com_instruction_text\",\n409:               \"com_scope\",\n410:               \"com_approval_receipt\",\n411:               \"com_status\",\n412:               \"com_effective_from\",\n413:               \"com_superseded_by\"\n414:             ],\n415:             \"com_councilreceipt\": [\n416:               \"com_receipt_id\",\n417:               \"com_verb\",\n418:               \"com_result\",\n419:               \"com_append_only_locked\"\n420:             ]\n421:           },\n422:           \"relationships\": [\n423:             \"com_councilapprovedinstruction.com_approval_receipt -> com_councilreceipt\",\n424:             \"com_councilapprovedinstruction.com_source_memory_candidate -> com_councilmemorycandidate\"\n425:           ],\n426:           \"views\": [\n427:             \"Memory Receipts\"\n428:           ],\n429:           \"writeScopeNote\": \"Story 4.4 needs Memory Candidate, Approved Instruction, and Receipt tables with the memory_promoted verb; it must not force Skill or Minion tables to exist.\",\n430:           \"exampleExistingRows\": [\n431:             \"CR-LOCAL-MEMORY-001\"\n432:           ]\n433:         }\n434:       ]\n435:     },\n436:     \"rollbackAuditBoundaries\": [\n437:       {\n438:         \"plannedWriteScope\": \"Epic 2 Story 2.3 apply-receipt-backed-queue-state-changes\",\n439:         \"storyKey\": \"2-3-apply-receipt-backed-queue-state-changes\",\n440:         \"writeScopeKey\": \"state-change-mutation\",\n441:         \"rollbackBoundary\": \"Roll back to the last append-only receipt boundary: every com_councilreceipt row is append-only (com_append_only_locked=true), so a failed state-change apply is rolled back by appending a corrective receipt rather than editing or deleting prior rows; the affected com_councilworkitem.com_state_group is restored to the before-state recorded on the failed receipt.\",\n442:         \"auditBoundary\": \"Every state-change write emits a manifest-verb com_councilreceipt with com_before_state, com_after_state, com_idempotency_key, and com_evidence_refs; the receipt is the audit row. No state change is auditably complete without a backing receipt.\",\n443:         \"receiptGate\": \"Live com_councilworkitem.com_state_group mutation is receipt-gated to Epic 2 Story 2.3; no live mutation is performed in this slice.\",\n444:         \"exampleExistingRows\": [\n445:           \"CWI-LOCAL-QUEUE-HAPPY-001\"\n446:         ]\n447:       },\n448:       {\n449:         \"plannedWriteScope\": \"Epic 1 Story 1.5 handle-source-drift-and-supersession live apply\",\n450:         \"storyKey\": \"1-5-handle-source-drift-and-supersession\",\n451:         \"writeScopeKey\": \"source-drift-supersession\",\n452:         \"rollbackBoundary\": \"Roll back to the prior source version: a supersession is reversed by capturing a new superseding record that points com_parent_ref back at the pre-supersession record, never by editing the superseded record or its prior rationale; the superseded record and its receipts stay byte-identical.\",\n453:         \"auditBoundary\": \"Every drift/supersession write emits a source_drifted com_councilreceipt bound to its source evidence by a com_councilreceiptsource row with com_evidence_role=drift_evidence; the drift receipt is the audit row for the version transition.\",\n454:         \"receiptGate\": \"Live com_councilsourcerecord version/supersession mutation is receipt-gated to Epic 2 Story 2.3; no live mutation is performed in this slice.\",\n455:         \"exampleExistingRows\": [\n456:           \"CSR-OUTLOOK-THREAD-MOCK-001\"\n457:         ]\n458:       },\n459:       {\n460:         \"plannedWriteScope\": \"Dataverse MVP schema apply (dataverse-apply-mvp-schema.ps1 with -ExecuteWrites)\",\n461:         \"storyKey\": \"5-5-validate-dataverse-mvp-operational-store-readiness\",\n462:         \"writeScopeKey\": \"schema-apply\",\n463:         \"rollbackBoundary\": \"Roll back the schema apply by deleting the CouncilOfMinionsMVP unmanaged solution in the sandbox environment; unmanaged solution deletion removes the Council tables/choices it introduced. The committed dataverse-mvp-schema-manifest.json is the re-apply source of truth, and the tenant decision packet records Doug's approval before any such apply runs.\",\n464:         \"auditBoundary\": \"The schema apply is gated behind a Doug-approved read-only preflight that proves target.environmentId and target.organizationId match `pac env who`; the preflight evidence and the tenant decision packet are the audit trail for the write authorization. The apply script's DRY RUN ONLY marker is the no-write boundary until approval.\",\n465:         \"receiptGate\": \"The schema apply itself is not a Council receipt event; it is a platform provisioning step approved through the tenant decision packet. It must stay in DRY RUN ONLY mode (writeScriptsDisabled=true) until Doug approves dataverseSandboxWrites and publisherPrefix.\",\n466:         \"exampleExistingRows\": []\n467:       }\n468:     ],\n469:     \"referencedIds\": [\n470:       {\n471:         \"id\": \"CSR-MANUAL-SUMMARY-001\",\n472:         \"idType\": \"CSR\",\n473:         \"sourceSlice\": \"manual-source-record-slice.json\",\n474:         \"referenceRole\": \"example-existing-source-row-in-scope-of-story-1.1-and-2.3-writes\"\n475:       },\n476:       {\n477:         \"id\": \"CSR-MANUAL-MEETING-001\",\n478:         \"idType\": \"CSR\",\n479:         \"sourceSlice\": \"zero-multi-item-extraction-slice.json\",\n480:         \"referenceRole\": \"example-existing-source-row-in-scope-of-story-1.5-drift-writes\"\n481:       },\n482:       {\n483:         \"id\": \"CSR-OUTLOOK-THREAD-MOCK-001\",\n484:         \"idType\": \"CSR\",\n485:         \"sourceSlice\": \"outlook-source-reference-slice.json\",\n486:         \"referenceRole\": \"example-superseded-source-row-in-rollback-boundary-for-story-1.5\"\n487:       },\n488:       {\n489:         \"id\": \"CWI-LOCAL-DECISION-001\",\n490:         \"idType\": \"CWI\",\n491:         \"sourceSlice\": \"proposed-work-item-extraction-slice.json\",\n492:         \"referenceRole\": \"example-existing-work-item-row-in-scope-of-story-1.3-writes\"\n493:       },\n494:       {\n495:         \"id\": \"CWI-LOCAL-SHELL-DECISION-001\",\n496:         \"idType\": \"CWI\",\n497:         \"sourceSlice\": \"work-item-execution-shell-slice.json\",\n498:         \"referenceRole\": \"example-existing-work-item-row-in-scope-of-story-2.1-writes\"\n499:       },\n500:       {\n501:         \"id\": \"CWI-LOCAL-QUEUE-HAPPY-001\",\n502:         \"idType\": \"CWI\",\n503:         \"sourceSlice\": \"receipt-backed-state-changes-slice.json\",\n504:         \"referenceRole\": \"example-existing-work-item-row-in-rollback-boundary-for-story-2.3\"\n505:       },\n506:       {\n507:         \"id\": \"CR-LOCAL-APPROVAL-PROPOSED-001\",\n508:         \"idType\": \"CR\",\n509:         \"sourceSlice\": \"approval-boundaries-slice.json\",\n510:         \"referenceRole\": \"example-existing-receipt-row-in-scope-of-story-1.3-writes\"\n511:       },\n512:       {\n513:         \"id\": \"CR-LOCAL-DRIFT-001\",\n514:         \"idType\": \"CR\",\n515:         \"sourceSlice\": \"source-drift-supersession-slice.json\",\n516:         \"referenceRole\": \"example-existing-receipt-row-in-audit-boundary-for-story-1.5\"\n517:       },\n518:       {\n519:         \"id\": \"CR-LOCAL-SHELL-CREATE-001\",\n520:         \"idType\": \"CR\",\n521:         \"sourceSlice\": \"work-item-execution-shell-slice.json\",\n522:         \"referenceRole\": \"example-existing-receipt-row-in-scope-of-story-2.1-writes\"\n523:       },\n524:       {\n525:         \"id\": \"CR-LOCAL-STATE-HAPPY-PROPOSED-001\",\n526:         \"idType\": \"CR\",\n527:         \"sourceSlice\": \"receipt-backed-state-changes-slice.json\",\n528:         \"referenceRole\": \"example-existing-receipt-row-in-rollback-boundary-for-story-2.3\"\n529:       },\n530:       {\n531:         \"id\": \"CR-LOCAL-MEMORY-001\",\n532:         \"idType\": \"CR\",\n533:         \"sourceSlice\": \"memory-candidates-slice.json\",\n534:         \"referenceRole\": \"example-existing-receipt-row-in-scope-of-story-4.4-writes\"\n535:       }\n536:     ],\n537:     \"writesDeferred\": [\n538:       {\n539:         \"deferredWrite\": \"Live `pac auth who`, `pac env who`, and `pac env list-settings` preflight execution\",\n540:         \"receiptGate\": \"Deferred to a Doug-approved read-only preflight under the Epic 5 tenant-readiness gate; no live pac call is performed in this slice.\",\n541:         \"evidenceState\": \"deferred-to-tenant\"\n542:       },\n543:       {\n544:         \"deferredWrite\": \"dataverse-apply-mvp-schema.ps1 -ExecuteWrites (solution/publisher/choice/table/column/relationship creation and publish)\",\n545:         \"writeScopeKey\": \"schema-apply\",\n546:         \"receiptGate\": \"Deferred until Doug approves dataverseSandboxWrites (allowed_after_readonly_preflight) and confirms publisherPrefix in the tenant decision packet; writeScriptsDisabled stays true in this slice.\",\n547:         \"evidenceState\": \"deferred-to-tenant\"\n548:       },\n549:       {\n550:         \"deferredWrite\": \"Any live com_councilworkitem.com_state_group mutation driven by earlier-slice receipts\",\n551:         \"writeScopeKey\": \"state-change-mutation\",\n552:         \"receiptGate\": \"Receipt-gated to Epic 2 Story 2.3 apply-receipt-backed-queue-state-changes; this slice records the rollback/audit boundary only and performs no live mutation.\",\n553:         \"evidenceState\": \"deferred-to-tenant\"\n554:       },\n555:       {\n556:         \"deferredWrite\": \"Any live com_councilsourcerecord version/supersession mutation driven by earlier-slice drift receipts\",\n557:         \"writeScopeKey\": \"source-drift-supersession\",\n558:         \"receiptGate\": \"Receipt-gated to Epic 2 Story 2.3 apply-receipt-backed-queue-state-changes; this slice records the rollback/audit boundary only and performs no live mutation.\",\n559:         \"evidenceState\": \"deferred-to-tenant\"\n560:       }\n561:     ]\n562:   },\n563:   \"acceptanceMapping\": [\n564:     {\n565:       \"acceptanceCriterion\": 1,\n566:       \"localEvidence\": [\n567:         \"dataverseReadinessRun.preflightContract.expectedCommands lists `pac auth who`, `pac env who`, and `pac env list-settings`, each with an evidenceShape whose every field is the literal 'VERIFY IN TENANT' and evidenceState=deferred-to-tenant; no concrete environment/org id is recorded\",\n568:         \"dataverseReadinessRun.preflightContract.noLivePacCallPerformed=true and guards.noLivePacCallInThisSlice=true and guards.preflightEvidenceDeferredToTenant=true\",\n569:         \"dataverseReadinessRun.pendingApprovals carries dataverseSandboxWrites and publisherPrefix as PENDING entries with requiredApprover=Doug and backingReceiptId=null; guards.writeScriptsDisabled=true (strict) and guards.noApprovalReceiptFabricated=true; no com_receipt_id appears anywhere in the slice\",\n570:         \"dataverseReadinessRun.writesDeferred records the live preflight and the schema apply as deferred entries naming their receipt gates\"\n571:       ],\n572:       \"tenantEvidenceRequired\": \"Live `pac auth who`, `pac env who`, `pac env list-settings` execution and the concrete environment/organization ID match against dataverse-mvp-schema-manifest.json remain VERIFY IN TENANT under the Epic 5 tenant-readiness gate; this slice is local contract evidence only and performs no live pac call.\"\n573:     },\n574:     {\n575:       \"acceptanceCriterion\": 2,\n576:       \"localEvidence\": [\n577:         \"dataverseReadinessRun.dryRunSchemaManifest.manifestRef references the committed dataverse-mvp-schema-manifest.json and guards.fullShapeNotForcedUpfront=true (strict)\",\n578:         \"dataverseReadinessRun.dryRunSchemaManifest.storyScopedWritePolicy is non-empty; every entry references a real epic story key, and every table/column it lists exists in dataverse-mvp-schema-manifest.json\",\n579:         \"dataverseReadinessRun.rollbackAuditBoundaries provides a rollback and an audit boundary statement per planned write scope, each referencing a real epic story key\",\n580:         \"guards.schemaWritesTiedToStoryScope=true and guards.rollbackAuditBoundaryPerPlannedWriteScope=true\"\n581:       ],\n582:       \"tenantEvidenceRequired\": \"Applying story-scoped schema writes to the live tenant (creating only the tables/columns each implementation story needs) remains gated to Doug's sandbox-write approval and the receipt-backed mutation semantics of Epic 2 Story 2.3; this slice records the dry-run mapping and boundaries only and performs no live schema write.\"\n583:     }\n584:   ]\n585: }\n\n(End of file - total 585 lines)\n</content>","metadata":{"preview":"{\n  \"artifactVersion\": \"2026-07-14\",\n  \"storyKey\": \"5-5-validate-dataverse-mvp-operational-store-readiness\",\n  \"status\": \"local-contract-not-tenant-verified\",\n  \"purpose\": \"Prove Dataverse MVP operational store readiness locally as CONTRACT evidence only: a read-only preflight contract describing the expected `pac auth who`, `pac env who`, and environment-settings evidence shape with every tenant value marked VERIFY IN TENANT and deferred-to-tenant; a story-scoped write policy mapping which manifest tables/columns each future implementation story needs (without forcing the full target shape upfront); and rollback/audit boundary statements per planned write scope. Write scripts stay disabled (writeScriptsDisabled=true) until Doug approves Dataverse sandbox writes and publisher prefix; those approvals are present as PENDING entries and no approval receipt is fabricated. No live pac/tenant call is performed in this slice; every would-be live write appears as a deferred entry naming its receipt gate.\",\n  \"guards\": {\n    \"noTenantWrites\": true,\n    \"noOutboundAction\": true,\n    \"writeScriptsDisabled\": true,\n    \"preflightEvidenceDeferredToTenant\": true,\n    \"noApprovalReceiptFabricated\": true,\n    \"fullShapeNotForcedUpfront\": true,\n    \"schemaWritesTiedToStoryScope\": true,\n    \"rollbackAuditBoundaryPerPlannedWriteScope\": true,\n    \"receiptsAreLocalContractEvidenceOnly\": true,\n    \"noLivePacCallInThisSlice\": true\n  },\n  \"dataverseReadinessRun\": {\n    \"runId\": \"READINESS-LOCAL-2026-07-14-001\",\n    \"actorType\": \"system\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/doug/.ringer/work/bmad-hybrid/5-5-validate-dataverse-mvp-operational-store-readiness/_bmad-output/implementation-artifacts/dataverse-readiness-slice.json","text":"{\n  \"artifactVersion\": \"2026-07-14\",\n  \"storyKey\": \"5-5-validate-dataverse-mvp-operational-store-readiness\",\n  \"status\": \"local-contract-not-tenant-verified\",\n  \"purpose\": \"Prove Dataverse MVP operational store readiness locally as CONTRACT evidence only: a read-only preflight contract describing the expected `pac auth who`, `pac env who`, and environment-settings evidence shape with every tenant value marked VERIFY IN TENANT and deferred-to-tenant; a story-scoped write policy mapping which manifest tables/columns each future implementation story needs (without forcing the full target shape upfront); and rollback/audit boundary statements per planned write scope. Write scripts stay disabled (writeScriptsDisabled=true) until Doug approves Dataverse sandbox writes and publisher prefix; those approvals are present as PENDING entries and no approval receipt is fabricated. No live pac/tenant call is performed in this slice; every would-be live write appears as a deferred entry naming its receipt gate.\",\n  \"guards\": {\n    \"noTenantWrites\": true,\n    \"noOutboundAction\": true,\n    \"writeScriptsDisabled\": true,\n    \"preflightEvidenceDeferredToTenant\": true,\n    \"noApprovalReceiptFabricated\": true,\n    \"fullShapeNotForcedUpfront\": true,\n    \"schemaWritesTiedToStoryScope\": true,\n    \"rollbackAuditBoundaryPerPlannedWriteScope\": true,\n    \"receiptsAreLocalContractEvidenceOnly\": true,\n    \"noLivePacCallInThisSlice\": true\n  },\n  \"dataverseReadinessRun\": {\n    \"runId\": \"READINESS-LOCAL-2026-07-14-001\",\n    \"actorType\": \"system\",\n    \"actorId\": \"local-bmad-validator\",\n    \"authorityBasis\": \"local non-tenant Story 5.5 contract validation; no live pac call and no tenant write performed\",\n    \"semanticContractVersion\": \"2026-07-07\",\n    \"inputManifestRef\": \"dataverse-mvp-schema-manifest.json\",\n    \"inputDecisionPacketRef\": \"tenant-decision-packet.json\",\n    \"inputSprintStatusRef\": \"sprint-status.yaml\",\n    \"inputSourceRecordsFrom\": [\n      \"manual-source-record-slice.json\",\n      \"outlook-source-reference-slice.json\",\n      \"proposed-work-item-extraction-slice.json\",\n      \"zero-multi-item-extraction-slice.json\",\n      \"source-drift-supersession-slice.json\"\n    ],\n    \"decisionPolicy\": {\n      \"preflightMustProveExpectedEnvironmentAndOrganizationBeforeAnyWrite\": true,\n      \"writeScriptsStayDisabledUntilDougApprovesSandboxWritesAndPublisherPrefix\": true,\n      \"noApprovalReceiptIsFabricatedWhileApprovalsArePending\": true,\n      \"schemaWritesTiedToCurrentStoryNeededTablesColumnsRelationshipsViews\": true,\n      \"dryRunManifestMayDescribeFullTargetShapeWithoutForcingItUpfront\": true,\n      \"rollbackAndAuditBoundaryStatedPerPlannedWriteScope\": true,\n      \"liveDataverseMutationReceiptGatedToEpic2Story23\": true,\n      \"receiptsAreLocalContractEvidenceOnly\": true\n    },\n    \"preflightContract\": {\n      \"evidenceState\": \"deferred-to-tenant\",\n      \"verificationMarker\": \"VERIFY IN TENANT\",\n      \"noLivePacCallPerformed\": true,\n      \"expectedCommands\": [\n        {\n          \"command\": \"pac auth who\",\n          \"purpose\": \"Prove the authenticated user context that would issue any future write.\",\n          \"evidenceShape\": {\n            \"userContextUPN\": \"VERIFY IN TENANT\",\n            \"loggedInUser\": \"VERIFY IN TENANT\",\n            \"tenantId\": \"VERIFY IN TENANT\"\n          },\n          \"evidenceState\": \"deferred-to-tenant\",\n          \"deferredTo\": \"Epic 5 tenant-readiness gate; live run of `pac auth who` is receipt-gated to a Doug-approved read-only preflight\"\n        },\n        {\n          \"command\": \"pac env who\",\n          \"purpose\": \"Prove the target environment ID, environment name, organization ID, and environment URL match the committed manifest target before any write.\",\n          \"evidenceShape\": {\n            \"environmentId\": \"VERIFY IN TENANT\",\n            \"environmentName\": \"VERIFY IN TENANT\",\n            \"organizationId\": \"VERIFY IN TENANT\",\n            \"environmentUrl\": \"VERIFY IN TENANT\"\n          },\n          \"evidenceState\": \"deferred-to-tenant\",\n          \"deferredTo\": \"Epic 5 tenant-readiness gate; live `pac env who` match against dataverse-mvp-schema-manifest.json target is receipt-gated to a Doug-approved read-only preflight\"\n        },\n        {\n          \"command\": \"pac env list-settings\",\n          \"purpose\": \"Capture environment settings evidence (organization settings, admin mode, throttle status) as read-only context for the readiness decision.\",\n          \"evidenceShape\": {\n            \"organizationSettings\": \"VERIFY IN TENANT\",\n            \"settingsHash\": \"VERIFY IN TENANT\",\n            \"adminMode\": \"VERIFY IN TENANT\"\n          },\n          \"evidenceState\": \"deferred-to-tenant\",\n          \"deferredTo\": \"Epic 5 tenant-readiness gate; live `pac env list-settings` capture is receipt-gated to a Doug-approved read-only preflight\"\n        }\n      ],\n      \"matchPolicy\": \"When the live preflight runs, the `pac env who` environment ID and organization ID MUST equal dataverse-mvp-schema-manifest.json target.environmentId and target.organizationId; a mismatch blocks every write. This slice records the expected SHAPE only and defers the concrete values to the tenant; no concrete environment or organization id is recorded here.\"\n    },\n    \"pendingApprovals\": [\n      {\n        \"approvalEntryId\": \"APPR-LOCAL-DV-SANDBOX-WRITES-001\",\n        \"decision\": \"dataverseSandboxWrites\",\n        \"requiredBefore\": \"dataverse-write\",\n        \"state\": \"PENDING\",\n        \"requiredApprover\": \"Doug\",\n        \"question\": \"Are Dataverse sandbox writes allowed after read-only preflight proves the target environment?\",\n        \"allowedValues\": [\n          \"forbidden\",\n          \"allowed_after_readonly_preflight\"\n        ],\n        \"receiptGate\": \"No approval receipt (CR-LOCAL-*) is fabricated for this approval until Doug explicitly approves; dataverse-apply-mvp-schema.ps1 must stay in DRY RUN ONLY mode and writeScriptsDisabled stays true.\",\n        \"writeScriptsDisabledUntilApproved\": true,\n        \"backingReceiptId\": null\n      },\n      {\n        \"approvalEntryId\": \"APPR-LOCAL-PUBLISHER-PREFIX-001\",\n        \"decision\": \"publisherPrefix\",\n        \"requiredBefore\": \"solution-creation\",\n        \"state\": \"PENDING\",\n        \"requiredApprover\": \"Doug\",\n        \"question\": \"What Dataverse publisher prefix should confirm the placeholder prefix before any solution creation write?\",\n        \"allowedValues\": [\n          \"com\"\n        ],\n        \"receiptGate\": \"No approval receipt (CR-LOCAL-*) is fabricated for this approval until Doug confirms the publisher prefix; publisher/solution creation writes stay disabled.\",\n        \"writeScriptsDisabledUntilApproved\": true,\n        \"backingReceiptId\": null\n      }\n    ],\n    \"dryRunSchemaManifest\": {\n      \"manifestRef\": \"dataverse-mvp-schema-manifest.json\",\n      \"manifestVersion\": \"2026-07-08\",\n      \"fullShapeNotForcedUpfront\": true,\n      \"fullShapeDescription\": \"dataverse-mvp-schema-manifest.json describes the full MVP target shape (14 tables, 15 global choices, model-driven app, sitemap). The dry run MAY reference the full shape for planning, but no implementation story is allowed to force all tables/columns to be created before that story needs them.\",\n      \"storyScopedWritePolicy\": [\n        {\n          \"storyKey\": \"1-1-capture-manual-source-records\",\n          \"epic\": 1,\n          \"tables\": [\n            \"com_councilsourcerecord\"\n          ],\n          \"columnsByTable\": {\n            \"com_councilsourcerecord\": [\n              \"com_name\",\n              \"com_council_source_record_id\",\n              \"com_source_system\",\n              \"com_source_kind\",\n              \"com_source_object_ref\",\n              \"com_captured_at\",\n              \"com_captured_by\",\n              \"com_extraction_status\",\n              \"com_source_to_work_item_rationale\",\n              \"com_data_boundary_policy\"\n            ]\n          },\n          \"relationships\": [],\n          \"views\": [\n            \"New Source Records\"\n          ],\n          \"writeScopeNote\": \"Story 1.1 only needs the Source Record table and its capture/boundary columns; it must not force Work Item or Receipt tables to exist.\",\n          \"exampleExistingRows\": [\n            \"CSR-MANUAL-SUMMARY-001\"\n          ]\n        },\n        {\n          \"storyKey\": \"1-3-extract-proposed-work-items-from-source-records\",\n          \"epic\": 1,\n          \"tables\": [\n            \"com_councilworkitem\",\n            \"com_councilworkitemsource\",\n            \"com_councilreceipt\"\n          ],\n          \"columnsByTable\": {\n            \"com_councilworkitem\": [\n              \"com_title\",\n              \"com_council_work_item_id\",\n              \"com_type\",\n              \"com_summary\",\n              \"com_state_group\",\n              \"com_risk_class\",\n              \"com_primary_source_record\",\n              \"com_rationale\",\n              \"com_approval_required\",\n              \"com_semantic_contract_version\"\n            ],\n            \"com_councilworkitemsource\": [\n              \"com_name\",\n              \"com_work_item\",\n              \"com_source_record\",\n              \"com_source_role\"\n            ],\n            \"com_councilreceipt\": [\n              \"com_receipt_id\",\n              \"com_work_item\",\n              \"com_verb\",\n              \"com_actor_type\",\n              \"com_actor_id\",\n              \"com_authority_basis\",\n              \"com_occurred_at\",\n              \"com_idempotency_key\",\n              \"com_result\",\n              \"com_append_only_locked\"\n            ]\n          },\n          \"relationships\": [\n            \"com_councilworkitem.com_primary_source_record -> com_councilsourcerecord\",\n            \"com_councilworkitemsource.com_work_item -> com_councilworkitem\",\n            \"com_councilworkitemsource.com_source_record -> com_councilsourcerecord\"\n  